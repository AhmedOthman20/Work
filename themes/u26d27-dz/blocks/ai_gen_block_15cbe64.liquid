{% doc %}
  @prompt
    create a videos carousel  with the videos dimensions of the Instagram reels and the option to add the videos as separate elements also i can link the video to certain product and auto play and show a controller of the volume wither be mute or not for every video and the section can show 5 videos per row with the option to increase it or decrease it also in the mobile view it can be displayed as carousel slider with arrows to navigate right and left and the product widget should contain a small image of the product and to be displayed under each video , make the desktop display as slider carousel can be navigated left and right not a grid , also make the videos height unified  , also adapt to the video's width ,don't change the video dimensions after assigning the product , don't change the video width to adapt to the product title width , you divide the product title into 2 lines , the videos assign takes source from the current product opened metafields  
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-carousel-{{ ai_gen_id }} {
    width: 100%;
    display: block;
    position: relative;
  }

  .ai-video-carousel-container-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    padding: 0 50px;
  }

  .ai-video-carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.video_gap }}px;
    transition: transform 0.4s ease;
  }

  .ai-video-carousel-item-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.videos_per_row | minus: 1 }} * {{ block.settings.video_gap }}px)) / {{ block.settings.videos_per_row }});
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    background-color: #000000;
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
  }

  .ai-video-element-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-video-controls-{{ ai_gen_id }} {
    position: absolute;
    bottom: 12px;
    right: 12px;
    z-index: 2;
  }

  .ai-volume-button-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: rgba(0, 0, 0, 0.6);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    transition: background-color 0.3s ease;
  }

  .ai-volume-button-{{ ai_gen_id }}:hover {
    background-color: rgba(0, 0, 0, 0.8);
  }

  .ai-volume-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-product-widget-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px;
    background-color: {{ block.settings.product_widget_bg }};
    border-radius: {{ block.settings.product_widget_radius }}px;
    text-decoration: none;
    transition: transform 0.3s ease;
  }

  .ai-product-widget-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
  }

  .ai-product-image-{{ ai_gen_id }} {
    width: 50px;
    height: 50px;
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
  }

  .ai-product-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-info-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
  }

  .ai-product-title-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    color: {{ block.settings.product_title_color }};
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.3;
  }

  .ai-product-price-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.product_price_color }};
    margin-top: 4px;
  }

  .ai-carousel-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: {{ block.settings.nav_button_bg }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.nav_button_color }};
    transition: all 0.3s ease;
    z-index: 3;
  }

  .ai-carousel-nav-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_bg }};
  }

  .ai-carousel-nav-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-carousel-nav-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-carousel-nav-prev-{{ ai_gen_id }} {
    left: 0;
  }

  .ai-carousel-nav-next-{{ ai_gen_id }} {
    right: 0;
  }

  .ai-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  .ai-empty-state-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    margin-bottom: 16px;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-video-carousel-container-{{ ai_gen_id }} {
      padding: 0 40px;
    }

    .ai-video-carousel-item-{{ ai_gen_id }} {
      flex: 0 0 100%;
    }

    .ai-carousel-nav-{{ ai_gen_id }} {
      width: 36px;
      height: 36px;
    }
  }
{% endstyle %}

<video-carousel-{{ ai_gen_id }} class="ai-video-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% liquid
    assign video_1 = product.metafields.custom.video_1.value
    assign video_2 = product.metafields.custom.video_2.value
    assign video_3 = product.metafields.custom.video_3.value
    assign video_4 = product.metafields.custom.video_4.value
    assign video_5 = product.metafields.custom.video_5.value
    assign video_6 = product.metafields.custom.video_6.value
    assign video_7 = product.metafields.custom.video_7.value
    assign video_8 = product.metafields.custom.video_8.value
    assign video_9 = product.metafields.custom.video_9.value
    assign video_10 = product.metafields.custom.video_10.value

    assign videos = ''
    assign videos = videos | append: video_1 | append: ',' | append: video_2 | append: ',' | append: video_3 | append: ',' | append: video_4 | append: ',' | append: video_5 | append: ',' | append: video_6 | append: ',' | append: video_7 | append: ',' | append: video_8 | append: ',' | append: video_9 | append: ',' | append: video_10
    assign video_array = videos | split: ','
    
    assign has_videos = false
    for vid in video_array
      if vid != blank
        assign has_videos = true
        break
      endif
    endfor
  %}

  {% if has_videos %}
    <div class="ai-video-carousel-container-{{ ai_gen_id }}">
      <button class="ai-carousel-nav-{{ ai_gen_id }} ai-carousel-nav-prev-{{ ai_gen_id }}" aria-label="Previous videos">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="ai-video-carousel-track-{{ ai_gen_id }}">
        {% for i in (1..10) %}
          {% liquid
            case i
              when 1
                assign current_video = video_1
                assign current_product = block.settings.product_1
              when 2
                assign current_video = video_2
                assign current_product = block.settings.product_2
              when 3
                assign current_video = video_3
                assign current_product = block.settings.product_3
              when 4
                assign current_video = video_4
                assign current_product = block.settings.product_4
              when 5
                assign current_video = video_5
                assign current_product = block.settings.product_5
              when 6
                assign current_video = video_6
                assign current_product = block.settings.product_6
              when 7
                assign current_video = video_7
                assign current_product = block.settings.product_7
              when 8
                assign current_video = video_8
                assign current_product = block.settings.product_8
              when 9
                assign current_video = video_9
                assign current_product = block.settings.product_9
              when 10
                assign current_video = video_10
                assign current_product = block.settings.product_10
            endcase
          %}

          {% if current_video != blank %}
            <div class="ai-video-carousel-item-{{ ai_gen_id }}" data-index="{{ forloop.index0 }}">
              <div class="ai-video-wrapper-{{ ai_gen_id }}">
                <video
                  class="ai-video-element-{{ ai_gen_id }}"
                  src="{{ current_video.sources[1].url }}"
                  {% if block.settings.autoplay %}autoplay{% endif %}
                  loop
                  muted
                  playsinline
                  preload="metadata"
                ></video>
                
                <div class="ai-video-controls-{{ ai_gen_id }}">
                  <button class="ai-volume-button-{{ ai_gen_id }}" aria-label="Toggle volume">
                    <svg class="ai-muted-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                      <line x1="23" y1="9" x2="17" y2="15"></line>
                      <line x1="17" y1="9" x2="23" y2="15"></line>
                    </svg>
                    <svg class="ai-unmuted-icon-{{ ai_gen_id }}" style="display: none;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                      <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                    </svg>
                  </button>
                </div>
              </div>

              {% if current_product != blank %}
                <a href="{{ current_product.url }}" class="ai-product-widget-{{ ai_gen_id }}">
                  <div class="ai-product-image-{{ ai_gen_id }}">
                    {% if current_product.featured_image %}
                      <img
                        src="{{ current_product.featured_image | image_url: width: 100 }}"
                        alt="{{ current_product.featured_image.alt | escape }}"
                        loading="lazy"
                        width="100"
                        height="100"
                      >
                    {% endif %}
                  </div>
                  <div class="ai-product-info-{{ ai_gen_id }}">
                    <h3 class="ai-product-title-{{ ai_gen_id }}">{{ current_product.title }}</h3>
                    <div class="ai-product-price-{{ ai_gen_id }}">{{ current_product.price | money }}</div>
                  </div>
                </a>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <button class="ai-carousel-nav-{{ ai_gen_id }} ai-carousel-nav-next-{{ ai_gen_id }}" aria-label="Next videos">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  {% else %}
    <div class="ai-empty-state-{{ ai_gen_id }}">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="23 7 16 12 23 17 23 7"></polygon>
        <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
      </svg>
      <p>Add video metafields to the product to display the carousel</p>
    </div>
  {% endif %}
</video-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.videosPerView = {{ block.settings.videos_per_row }};
        this.isMobile = window.innerWidth <= 749;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-video-carousel-track-{{ ai_gen_id }}');
        this.items = this.querySelectorAll('.ai-video-carousel-item-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-carousel-nav-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-carousel-nav-next-{{ ai_gen_id }}');
        this.volumeButtons = this.querySelectorAll('.ai-volume-button-{{ ai_gen_id }}');

        if (!this.track || this.items.length === 0) return;

        this.setupNavigation();
        this.setupVolumeControls();
        this.setupIntersectionObserver();
        this.updateNavButtons();

        window.addEventListener('resize', () => {
          const wasMobile = this.isMobile;
          this.isMobile = window.innerWidth <= 749;
          if (wasMobile !== this.isMobile) {
            this.videosPerView = this.isMobile ? 1 : {{ block.settings.videos_per_row }};
            this.currentIndex = 0;
            this.updateCarousel();
          }
        });
      }

      setupNavigation() {
        this.prevButton.addEventListener('click', () => this.navigate(-1));
        this.nextButton.addEventListener('click', () => this.navigate(1));
      }

      navigate(direction) {
        const maxIndex = Math.max(0, this.items.length - this.videosPerView);
        this.currentIndex = Math.max(0, Math.min(maxIndex, this.currentIndex + direction));
        this.updateCarousel();
      }

      updateCarousel() {
        const itemWidth = this.items[0].offsetWidth;
        const gap = {{ block.settings.video_gap }};
        const offset = -(this.currentIndex * (itemWidth + gap));
        this.track.style.transform = `translateX(${offset}px)`;
        this.updateNavButtons();
      }

      updateNavButtons() {
        const maxIndex = Math.max(0, this.items.length - this.videosPerView);
        this.prevButton.disabled = this.currentIndex === 0;
        this.nextButton.disabled = this.currentIndex >= maxIndex;
      }

      setupVolumeControls() {
        this.volumeButtons.forEach((button, index) => {
          const video = this.items[index].querySelector('.ai-video-element-{{ ai_gen_id }}');
          const mutedIcon = button.querySelector('.ai-muted-icon-{{ ai_gen_id }}');
          const unmutedIcon = button.querySelector('.ai-unmuted-icon-{{ ai_gen_id }}');

          button.addEventListener('click', () => {
            video.muted = !video.muted;
            if (video.muted) {
              mutedIcon.style.display = 'block';
              unmutedIcon.style.display = 'none';
            } else {
              mutedIcon.style.display = 'none';
              unmutedIcon.style.display = 'block';
            }
          });
        });
      }

      setupIntersectionObserver() {
        const options = {
          root: null,
          rootMargin: '0px',
          threshold: 0.5
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            const video = entry.target.querySelector('.ai-video-element-{{ ai_gen_id }}');
            if (entry.isIntersecting && {{ block.settings.autoplay }}) {
              video.play();
            } else {
              video.pause();
            }
          });
        }, options);

        this.items.forEach(item => observer.observe(item));
      }
    }

    customElements.define('video-carousel-{{ ai_gen_id }}', VideoCarousel{{ ai_gen_id }});
  })();
</script>

