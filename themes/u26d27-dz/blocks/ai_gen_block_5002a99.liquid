{% doc %}
  @prompt
    create a videos carousel  with the videos dimensions of the Instagram reels and the option to add the videos as separate elements also i can link the video to certain product and auto play the selected video and show a controller of the volume wither be mute or not for every video and the section can show 5 videos per row with the option to increase it or decrease it also in the mobile view it can be displayed as carousel slider with arrows to navigate right and left and the product widget should contain a small image of the product and to be displayed under each video , make the desktop display as slider carousel can be navigated left and right not a grid , also make the videos height unified  , also adapt to the video's width
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-carousel-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
    position: relative;
  }

  .ai-video-carousel__wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-video-carousel__container-{{ ai_gen_id }} {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: {{ block.settings.gap }}px;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-behavior: smooth;
    align-items: flex-start;
  }

  .ai-video-carousel__container-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-video-carousel__item-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    scroll-snap-align: start;
  }

  @media screen and (min-width: 750px) {
    .ai-video-carousel__container-{{ ai_gen_id }} {
      padding: 0 60px;
    }

    .ai-video-carousel__item-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.gap }}px * ({{ block.settings.videos_per_row }} - 1))) / {{ block.settings.videos_per_row }});
    }
  }

  @media screen and (max-width: 749px) {
    .ai-video-carousel__container-{{ ai_gen_id }} {
      padding: 0 20px;
    }

    .ai-video-carousel__item-{{ ai_gen_id }} {
      flex: 0 0 80%;
    }
  }

  .ai-video-carousel__video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    background-color: #000000;
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
  }

  .ai-video-carousel__video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-carousel__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-video-carousel__placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.3;
  }

  .ai-video-carousel__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    font-size: 12px;
    color: #ffffff;
    text-align: center;
    pointer-events: none;
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 4px;
  }

  .ai-video-carousel__volume-btn-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: rgba(0, 0, 0, 0.6);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    transition: background-color 0.3s ease;
    z-index: 2;
  }

  .ai-video-carousel__volume-btn-{{ ai_gen_id }}:hover {
    background-color: rgba(0, 0, 0, 0.8);
  }

  .ai-video-carousel__volume-btn-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-video-carousel__product-widget-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    background-color: {{ block.settings.widget_background_color }};
    border-radius: {{ block.settings.widget_border_radius }}px;
    text-decoration: none;
    transition: transform 0.3s ease;
  }

  .ai-video-carousel__product-widget-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
  }

  .ai-video-carousel__product-image-{{ ai_gen_id }} {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
  }

  .ai-video-carousel__product-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-carousel__product-info-{{ ai_gen_id }} {
    flex-grow: 1;
    min-width: 0;
  }

  .ai-video-carousel__product-title-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    margin: 0 0 4px;
    color: {{ block.settings.widget_text_color }};
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ai-video-carousel__product-price-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.widget_text_color }};
    opacity: 0.8;
  }

  .ai-video-carousel__controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-top: 20px;
  }

  .ai-video-carousel__arrow-{{ ai_gen_id }} {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: {{ block.settings.arrow_background_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.arrow_color }};
    transition: background-color 0.3s ease;
  }

  .ai-video-carousel__arrow-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_hover_background_color }};
  }

  .ai-video-carousel__arrow-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-video-carousel__arrow-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  @media screen and (min-width: 750px) {
    .ai-video-carousel__arrow-{{ ai_gen_id }} {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 3;
    }

    .ai-video-carousel__arrow-prev-{{ ai_gen_id }} {
      left: 10px;
    }

    .ai-video-carousel__arrow-next-{{ ai_gen_id }} {
      right: 10px;
    }

    .ai-video-carousel__controls-{{ ai_gen_id }} {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-video-carousel__arrow-{{ ai_gen_id }} {
      position: static;
      transform: none;
    }
  }
{% endstyle %}

<video-carousel-{{ ai_gen_id }}
  class="ai-video-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-video-carousel__wrapper-{{ ai_gen_id }}">
    <button
      class="ai-video-carousel__arrow-{{ ai_gen_id }} ai-video-carousel__arrow-prev-{{ ai_gen_id }}"
      aria-label="Previous video"
      data-arrow="prev"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <div class="ai-video-carousel__container-{{ ai_gen_id }}" data-carousel-container>
      {% for i in (1..10) %}
        {% liquid
          assign video_enabled_key = 'video_' | append: i | append: '_enabled'
          assign video_key = 'video_' | append: i
          assign product_key = 'video_' | append: i | append: '_product'
          assign autoplay_key = 'video_' | append: i | append: '_autoplay'

          assign video_enabled = block.settings[video_enabled_key]
          assign video = block.settings[video_key]
          assign product = block.settings[product_key]
          assign autoplay = block.settings[autoplay_key]
        %}

        {% if video_enabled %}
          <div class="ai-video-carousel__item-{{ ai_gen_id }}">
            <div class="ai-video-carousel__video-wrapper-{{ ai_gen_id }}">
              {% if video %}
                <video
                  class="ai-video-carousel__video-{{ ai_gen_id }}"
                  src="{{ video.sources[1].url }}"
                  {% if autoplay %}
                    autoplay
                    loop
                    muted
                    playsinline
                  {% endif %}
                  data-video-index="{{ i }}"
                ></video>

                <button
                  class="ai-video-carousel__volume-btn-{{ ai_gen_id }}"
                  aria-label="Toggle mute"
                  data-volume-btn="{{ i }}"
                >
                  <svg
                    class="ai-video-carousel__volume-icon-muted-{{ ai_gen_id }}"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                    <line x1="23" y1="9" x2="17" y2="15"></line>
                    <line x1="17" y1="9" x2="23" y2="15"></line>
                  </svg>
                  <svg
                    class="ai-video-carousel__volume-icon-unmuted-{{ ai_gen_id }}"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    style="display: none;"
                  >
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                  </svg>
                </button>
              {% else %}
                <div class="ai-video-carousel__placeholder-{{ ai_gen_id }}">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polygon points="23 7 16 12 23 17 23 7"></polygon>
                    <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                  </svg>
                  <div class="ai-video-carousel__empty-state-{{ ai_gen_id }}">
                    Add video {{ i }}
                  </div>
                </div>
              {% endif %}
            </div>

            {% if product != blank %}
              <a
                href="{{ product.url }}"
                class="ai-video-carousel__product-widget-{{ ai_gen_id }}"
              >
                <div class="ai-video-carousel__product-image-{{ ai_gen_id }}">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 120 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      width="120"
                      height="120"
                      loading="lazy"
                    >
                  {% endif %}
                </div>
                <div class="ai-video-carousel__product-info-{{ ai_gen_id }}">
                  <h3 class="ai-video-carousel__product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
                  <div class="ai-video-carousel__product-price-{{ ai_gen_id }}">{{ product.price | money }}</div>
                </div>
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <button
      class="ai-video-carousel__arrow-{{ ai_gen_id }} ai-video-carousel__arrow-next-{{ ai_gen_id }}"
      aria-label="Next video"
      data-arrow="next"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>

  <div class="ai-video-carousel__controls-{{ ai_gen_id }}">
    <button
      class="ai-video-carousel__arrow-{{ ai_gen_id }} ai-video-carousel__arrow-prev-mobile-{{ ai_gen_id }}"
      aria-label="Previous video"
      data-arrow="prev"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <button
      class="ai-video-carousel__arrow-{{ ai_gen_id }} ai-video-carousel__arrow-next-mobile-{{ ai_gen_id }}"
      aria-label="Next video"
      data-arrow="next"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>
</video-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.container = this.querySelector('[data-carousel-container]');
        this.videos = this.querySelectorAll('.ai-video-carousel__video-{{ ai_gen_id }}');
        this.volumeBtns = this.querySelectorAll('[data-volume-btn]');
        this.prevBtns = this.querySelectorAll('[data-arrow="prev"]');
        this.nextBtns = this.querySelectorAll('[data-arrow="next"]');
        this.videosPerRow = {{ block.settings.videos_per_row }};
      }

      connectedCallback() {
        this.setupVolumeControls();
        this.setupNavigation();
        this.updateArrowStates();
        this.container.addEventListener('scroll', () => this.updateArrowStates());
      }

      setupVolumeControls() {
        this.volumeBtns.forEach((btn) => {
          const videoIndex = btn.getAttribute('data-volume-btn');
          const video = this.querySelector(`[data-video-index="${videoIndex}"]`);
          const mutedIcon = btn.querySelector('.ai-video-carousel__volume-icon-muted-{{ ai_gen_id }}');
          const unmutedIcon = btn.querySelector('.ai-video-carousel__volume-icon-unmuted-{{ ai_gen_id }}');

          btn.addEventListener('click', () => {
            if (video.muted) {
              video.muted = false;
              mutedIcon.style.display = 'none';
              unmutedIcon.style.display = 'block';
            } else {
              video.muted = true;
              mutedIcon.style.display = 'block';
              unmutedIcon.style.display = 'none';
            }
          });
        });
      }

      setupNavigation() {
        this.prevBtns.forEach((btn) => {
          btn.addEventListener('click', () => this.scrollCarousel('prev'));
        });

        this.nextBtns.forEach((btn) => {
          btn.addEventListener('click', () => this.scrollCarousel('next'));
        });
      }

      scrollCarousel(direction) {
        const items = this.querySelectorAll('.ai-video-carousel__item-{{ ai_gen_id }}');
        if (items.length === 0) return;

        const itemWidth = items[0].offsetWidth;
        const gap = {{ block.settings.gap }};
        const scrollAmount = (itemWidth + gap) * this.videosPerRow;

        if (direction === 'prev') {
          this.container.scrollBy({
            left: -scrollAmount,
            behavior: 'smooth'
          });
        } else {
          this.container.scrollBy({
            left: scrollAmount,
            behavior: 'smooth'
          });
        }
      }

      updateArrowStates() {
        const isAtStart = this.container.scrollLeft <= 0;
        const isAtEnd = this.container.scrollLeft + this.container.offsetWidth >= this.container.scrollWidth - 1;

        this.prevBtns.forEach((btn) => {
          btn.disabled = isAtStart;
        });

        this.nextBtns.forEach((btn) => {
          btn.disabled = isAtEnd;
        });
      }
    }

    customElements.define('video-carousel-{{ ai_gen_id }}', VideoCarousel{{ ai_gen_id }});
  })();
</script>

