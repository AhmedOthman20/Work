{%- comment -%}
  Shop by Category — circular category tiles
  Pure CSS, RTL-safe (logical properties), fully editor-configurable.
  Add as: sections/shop-by-category.liquid
{%- endcomment -%}

{%- liquid
  assign sid = section.id
-%}

<style>
  #sbc-{{ sid }} {
    --sbc-circle: {{ section.settings.circle_size_desktop }}px;
    --sbc-circle-m: {{ section.settings.circle_size_mobile }}px;
    --sbc-border: {{ section.settings.border_width }}px;
    --sbc-border-color: {{ section.settings.border_color }};
    --sbc-circle-bg: {{ section.settings.circle_bg }};
    --sbc-gap: {{ section.settings.gap_desktop }}px;
    --sbc-gap-m: {{ section.settings.gap_mobile }}px;
    --sbc-pad: {{ section.settings.image_padding }}%;
    --sbc-heading-size: {{ section.settings.heading_size }}px;
    --sbc-heading-size-m: {{ section.settings.heading_size_mobile }}px;
    --sbc-label-size: {{ section.settings.label_size }}px;
    --sbc-label-size-m: {{ section.settings.label_size_mobile }}px;
    --sbc-text: {{ section.settings.text_color }};
    --sbc-bg: {{ section.settings.section_bg }};
    background: var(--sbc-bg);
    color: var(--sbc-text);
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }

  #sbc-{{ sid }} .sbc__inner {
    max-width: {{ section.settings.max_width }}px;
    margin-inline: auto;
    padding-inline: 20px;
  }

  #sbc-{{ sid }} .sbc__heading {
    margin: 0 0 {{ section.settings.heading_spacing }}px;
    text-align: {{ section.settings.heading_align }};
    font-size: var(--sbc-heading-size);
    line-height: 1.1;
    text-transform: {% if section.settings.heading_uppercase %}uppercase{% else %}none{% endif %};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    color: inherit;
    font-family: var(--heading-font-family);
  }

  #sbc-{{ sid }} .sbc__list {
    display: flex;
    gap: var(--sbc-gap);
    list-style: none;
    margin: 0;
    padding: 0 0 6px;
    justify-content: {{ section.settings.desktop_align }};
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 20px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  #sbc-{{ sid }} .sbc__list::-webkit-scrollbar { display: none; }

  #sbc-{{ sid }} .sbc__item {
    flex: 0 0 var(--sbc-circle);
    scroll-snap-align: start;
    text-align: center;
  }

  #sbc-{{ sid }} .sbc__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  #sbc-{{ sid }} .sbc__circle {
    display: block;
    position: relative;
    width: var(--sbc-circle);
    max-width: none;
    margin-inline: auto;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    border: var(--sbc-border) solid var(--sbc-border-color);
    background: var(--sbc-circle-bg);
    overflow: hidden;
    box-sizing: border-box;
    transition: transform .3s ease, border-color .3s ease;
  }

  #sbc-{{ sid }} .sbc__circle img,
  #sbc-{{ sid }} .sbc__circle svg {
    position: absolute;
    inset: var(--sbc-pad);
    width: calc(100% - var(--sbc-pad) * 2);
    height: calc(100% - var(--sbc-pad) * 2);
    max-width: none;
    margin: 0;
    object-fit: {{ section.settings.image_fit }};
    transition: transform .4s ease;
  }

  {%- if section.settings.hover_effect -%}
  @media (hover: hover) {
    #sbc-{{ sid }} .sbc__link:hover .sbc__circle { border-color: {{ section.settings.border_hover_color }}; }
    #sbc-{{ sid }} .sbc__link:hover .sbc__circle img { transform: scale(1.08); }
  }
  {%- endif -%}

  #sbc-{{ sid }} .sbc__label {
    display: block;
    margin-top: {{ section.settings.label_spacing }}px;
    font-size: var(--sbc-label-size);
    font-weight: {{ section.settings.label_weight }};
    line-height: 1.2;
  }

  @media (max-width: 749px) {
    #sbc-{{ sid }} .sbc__heading { font-size: var(--sbc-heading-size-m); }
    #sbc-{{ sid }} .sbc__list {
      gap: var(--sbc-gap-m);
      justify-content: flex-start;
      margin-inline: -20px;
      padding-inline: 20px;
    }
    #sbc-{{ sid }} .sbc__item { flex-basis: var(--sbc-circle-m); }
    #sbc-{{ sid }} .sbc__circle { width: var(--sbc-circle-m); }
    #sbc-{{ sid }} .sbc__label { font-size: var(--sbc-label-size-m); }

    {%- if section.settings.mobile_layout == 'grid' -%}
    #sbc-{{ sid }} .sbc__list {
      display: grid;
      grid-template-columns: repeat({{ section.settings.mobile_columns }}, minmax(0, 1fr));
      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
    }
    #sbc-{{ sid }} .sbc__item { flex: none; min-width: 0; }
    #sbc-{{ sid }} .sbc__circle {
      width: 100%;
      border-width: {{ section.settings.border_width_mobile }}px;
    }
    #sbc-{{ sid }} .sbc__label {
      margin-top: {{ section.settings.label_spacing_mobile }}px;
      overflow-wrap: anywhere;
    }
    {%- endif -%}
  }
</style>

<section id="sbc-{{ sid }}" class="sbc">
  <div class="sbc__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="sbc__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <ul class="sbc__list" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          assign img = block.settings.image | default: col.featured_image
          assign label = block.settings.title | default: col.title
          assign url = block.settings.link | default: col.url
        -%}
        <li class="sbc__item" {{ block.shopify_attributes }}>
          <a class="sbc__link" href="{{ url | default: '#' }}">
            <span class="sbc__circle">
              {%- if img != blank -%}
                {{ img | image_url: width: 400 | image_tag:
                  loading: 'lazy',
                  widths: '150, 200, 300, 400',
                  sizes: '(max-width: 749px) 120px, 180px',
                  alt: label | escape
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag }}
              {%- endif -%}
            </span>
            {%- if label != blank -%}
              <span class="sbc__label">{{ label | escape }}</span>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Shop by category",
  "tag": "div",
  "class": "section-shop-by-category",
  "max_blocks": 20,
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "range", "id": "heading_size", "label": "Heading size (desktop)", "min": 20, "max": 80, "step": 2, "unit": "px", "default": 56 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 16, "max": 50, "step": 2, "unit": "px", "default": 30 },
    { "type": "checkbox", "id": "heading_uppercase", "label": "Uppercase heading", "default": true },
    { "type": "range", "id": "heading_letter_spacing", "label": "Heading letter spacing", "min": -2, "max": 10, "step": 0.5, "unit": "px", "default": 0 },
    {
      "type": "select", "id": "heading_align", "label": "Heading alignment", "default": "center",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "End" }
      ]
    },
    { "type": "range", "id": "heading_spacing", "label": "Space below heading", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 16 },

    { "type": "header", "content": "Circles" },
    { "type": "range", "id": "circle_size_desktop", "label": "Circle size (desktop)", "min": 80, "max": 260, "step": 5, "unit": "px", "default": 175 },
    { "type": "range", "id": "circle_size_mobile", "label": "Circle size (mobile)", "min": 60, "max": 180, "step": 5, "unit": "px", "default": 110 },
    { "type": "range", "id": "border_width", "label": "Border width", "min": 0, "max": 12, "step": 1, "unit": "px", "default": 6 },
    { "type": "color", "id": "border_color", "label": "Border color", "default": "#000000" },
    { "type": "color", "id": "circle_bg", "label": "Circle background", "default": "#ffffff" },
    {
      "type": "select", "id": "image_fit", "label": "Image fit", "default": "contain",
      "info": "Contain suits product cutouts on white. Cover fills the circle.",
      "options": [
        { "value": "contain", "label": "Contain" },
        { "value": "cover", "label": "Cover" }
      ]
    },
    { "type": "range", "id": "image_padding", "label": "Image inner padding", "min": 0, "max": 20, "step": 1, "unit": "%", "default": 8 },
    { "type": "checkbox", "id": "hover_effect", "label": "Hover zoom effect", "default": true },
    { "type": "color", "id": "border_hover_color", "label": "Border hover color", "default": "#000000" },

    { "type": "header", "content": "Labels" },
    { "type": "range", "id": "label_size", "label": "Label size (desktop)", "min": 12, "max": 36, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "label_size_mobile", "label": "Label size (mobile)", "min": 8, "max": 24, "step": 1, "unit": "px", "default": 11 },
    {
      "type": "select", "id": "label_weight", "label": "Label weight", "default": "500",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ]
    },
    { "type": "range", "id": "label_spacing", "label": "Space above label", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 22 },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "gap_desktop", "label": "Gap between items (desktop)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "gap_mobile", "label": "Gap between items (mobile)", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 8 },

    { "type": "header", "content": "Mobile layout" },
    {
      "type": "select", "id": "mobile_layout", "label": "Mobile layout", "default": "grid",
      "options": [
        { "value": "grid", "label": "Fixed row (all visible)" },
        { "value": "scroll", "label": "Swipe slider" }
      ]
    },
    { "type": "range", "id": "mobile_columns", "label": "Items per row (fixed row)", "min": 2, "max": 6, "step": 1, "default": 6 },
    { "type": "range", "id": "border_width_mobile", "label": "Border width (fixed row)", "min": 0, "max": 8, "step": 1, "unit": "px", "default": 2 },
    { "type": "range", "id": "label_spacing_mobile", "label": "Space above label (fixed row)", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 8 },
    {
      "type": "select", "id": "desktop_align", "label": "Desktop alignment", "default": "center",
      "info": "When items overflow, the row becomes swipeable.",
      "options": [
        { "value": "flex-start", "label": "Start" },
        { "value": "center", "label": "Center" },
        { "value": "space-between", "label": "Spread out" }
      ]
    },
    { "type": "range", "id": "max_width", "label": "Max content width", "min": 800, "max": 1800, "step": 20, "unit": "px", "default": 1320 },

    { "type": "header", "content": "Colors & spacing" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#000000" },
    { "type": "color", "id": "section_bg", "label": "Section background", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Image, title and link come from the collection unless overridden below." },
        { "type": "image_picker", "id": "image", "label": "Custom image (optional)" },
        { "type": "text", "id": "title", "label": "Custom label (optional)" },
        { "type": "url", "id": "link", "label": "Custom link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by category",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
