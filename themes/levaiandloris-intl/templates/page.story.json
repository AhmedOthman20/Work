    "who_is_levai": {
      "type": "media-with-text",
      "blocks": {
        "levai_intro": {
          "type": "image",
          "settings": {
            "image": "shopify:\/\/shop_images\/0_Levai-Room-1-1240x932.png",
            "media_width": 50,
            "media_position": "start",
            "text_position": "place-self-center text-center",
            "icon": "none",
            "icon_width": 48,
            "subheading": "Meet the Dreamer",
            "title": "Who is Levai?",
            "content": "<p>Levai, who loved space and had a great sense of style, often found himself going to the edges of his busy city. There, under the wide branches of a tall oak tree, he felt calm and peaceful. Levai spent many hours practicing his skateboarding tricks with his skateboard by his side. The sound of his board against the tree's bark filled the air with rhythm and energy.<\/p>",
            "link_text": "",
            "link_url": "",
            "background": "#1a1a1a",
            "background_gradient": "",
            "text_color": "#ffffff",
            "text_gradient": "",
            "button_background": "",
            "button_text_color": ""
          }
        }
      },
      "block_order": [
        "levai_intro"
      ],
      "settings": {
        "full_width": false,
        "alternate_media_position": false,
        "spacing": "none"
      }
    },
    "levai_sanctuary": {
      "type": "rich-text",
      "blocks": {
        "content": {
          "type": "richtext",
          "settings": {
            "content": "<p>To him, this spot wasn't just a place; it was a sanctuary, a haven where he could immerse himself in the wonders of the universe and the beauty of the natural world.<\/p>"
          }
        }
      },
      "block_order": [
        "content"
      ],
      "settings": {
        "full_width": true,
        "content_width": "medium",
        "text_position": "center",
        "background": "#f2f2f2",
