            "media_width": 50,
            "media_position": "end",
            "text_position": "place-self-center text-center",
            "icon": "none",
            "icon_width": 48,
            "subheading": "Meet the Creator",
            "title": "Who is Loris?",
            "content": "<p>On the other side of the same coin was Loris, a beacon of creativity and beauty in her own right. As a burgeoning beauty blogger, Loris sought inspiration in the simplest of places, often retreating to the shade of the very same oak tree that Levai frequented.<\/p>",
            "link_text": "",
            "link_url": "",
            "background": "#ffffff",
            "background_gradient": "",
            "text_color": "#1a1a1a",
            "text_gradient": "",
            "button_background": "",
            "button_text_color": ""
          }
        }
      },
      "block_order": [
        "loris_intro"
      ],
      "settings": {
        "full_width": false,
        "alternate_media_position": false,
        "spacing": "none"
      }
    },
