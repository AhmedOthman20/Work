        },
        "heading": {
          "type": "heading",
          "settings": {
            "text": "Years Under the Oak",
            "heading_tag": "h2",
            "text_color": "",
            "gradient": ""
          }
        },
        "content": {
          "type": "richtext",
          "settings": {
            "content": "<p>For many years, the tree played a significant role in their lives. Levai typically visited at night while Loris preferred the morning. Their paths never crossed, yet they shared the same sacred space.<\/p>"
          }
        }
      },
      "block_order": [
        "subheading",
        "heading",
        "content"
      ],
      "settings": {
