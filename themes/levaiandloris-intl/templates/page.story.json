            "text_position": "place-self-center text-center",
            "icon": "none",
            "icon_width": 48,
            "subheading": "A Twist of Fate",
            "title": "The Oak in Danger",
            "content": "<p>Their paths converged one fateful day when news spread that the landowner intended to sell the property, spelling doom for the beloved oak tree.<\/p>",
            "link_text": "",
            "link_url": "",
            "background": "#1a1a1a",
            "background_gradient": "",
            "text_color": "#ffffff",
            "text_gradient": "",
            "button_background": "",
