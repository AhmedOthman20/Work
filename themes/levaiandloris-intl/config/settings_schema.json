      },
      {
        "type": "checkbox",
        "id": "zoom_image_on_hover",
        "label": "Zoom image on hover",
        "info": "Various images are zoomed when hovered.",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "stagger_products_apparition",
        "label": "Reveal products one by one",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "reduce_drawer_animation",
        "label": "Reduce drawer animation",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "reduce_menu_animation",
        "label": "Reduce header menu animation",
        "default": false
      },
      {
        "type": "select",
        "id": "heading_apparition",
