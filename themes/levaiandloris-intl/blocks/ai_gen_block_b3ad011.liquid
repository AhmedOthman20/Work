{% doc %}
  @prompt
    build an images carousel slider with the dimensions on 300*300 px , it can contain 5 or more images in desktop and 2 per raw in mobile , the whole section auto scroll from left to right with speed can be adjusted both in desktop and mobile, i can add the images separately 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-carousel-container-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    padding: 20px 0;
  }

  .ai-carousel-wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    animation: ai-carousel-scroll-{{ ai_gen_id }} {{ block.settings.desktop_speed }}s linear infinite;
  }

  .ai-carousel-wrapper-{{ ai_gen_id }}:hover {
    animation-play-state: paused;
  }

  .ai-carousel-item-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 300px;
    height: 300px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-carousel-item-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-carousel-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-carousel-placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    opacity: 0.3;
  }

  {% assign total_images = 0 %}
  {% for i in (1..10) %}
    {% assign image_key = 'image_' | append: i %}
    {% if block.settings[image_key] %}
      {% assign total_images = total_images | plus: 1 %}
    {% endif %}
  {% endfor %}

  @keyframes ai-carousel-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-300px * {{ total_images }} - {{ block.settings.gap }}px * {{ total_images }}));
    }
  }

  @media screen and (max-width: 749px) {
    .ai-carousel-wrapper-{{ ai_gen_id }} {
      animation: ai-carousel-scroll-mobile-{{ ai_gen_id }} {{ block.settings.mobile_speed }}s linear infinite;
    }

    .ai-carousel-item-{{ ai_gen_id }} {
      width: calc(50% - {{ block.settings.gap | divided_by: 2 }}px);
      height: calc(50vw - {{ block.settings.gap | divided_by: 2 }}px);
      max-height: 300px;
    }

    @keyframes ai-carousel-scroll-mobile-{{ ai_gen_id }} {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(calc(-100%));
      }
    }
  }
{% endstyle %}

<auto-carousel-{{ ai_gen_id }}
  class="ai-carousel-container-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-carousel-wrapper-{{ ai_gen_id }}">
    {% assign has_images = false %}
    {% for i in (1..10) %}
      {% assign image_key = 'image_' | append: i %}
      {% if block.settings[image_key] %}
        {% assign has_images = true %}
      {% endif %}
    {% endfor %}

    {% if has_images %}
      {% for i in (1..10) %}
        {% assign image_key = 'image_' | append: i %}
        {% if block.settings[image_key] %}
          <div class="ai-carousel-item-{{ ai_gen_id }}">
            <img
              src="{{ block.settings[image_key] | image_url: width: 600 }}"
              alt="{{ block.settings[image_key].alt | escape }}"
              loading="lazy"
              width="300"
              height="300"
            >
          </div>
        {% endif %}
      {% endfor %}
      {% for i in (1..10) %}
        {% assign image_key = 'image_' | append: i %}
        {% if block.settings[image_key] %}
          <div class="ai-carousel-item-{{ ai_gen_id }}">
            <img
              src="{{ block.settings[image_key] | image_url: width: 600 }}"
              alt="{{ block.settings[image_key].alt | escape }}"
              loading="lazy"
              width="300"
              height="300"
            >
          </div>
        {% endif %}
      {% endfor %}
    {% else %}
      {% for i in (1..5) %}
        <div class="ai-carousel-item-{{ ai_gen_id }}">
          <div class="ai-carousel-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        </div>
      {% endfor %}
      {% for i in (1..5) %}
        <div class="ai-carousel-item-{{ ai_gen_id }}">
          <div class="ai-carousel-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</auto-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class AutoCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.wrapper = this.querySelector('.ai-carousel-wrapper-{{ ai_gen_id }}');
        this.setupInfiniteScroll();
      }

      setupInfiniteScroll() {
        if (!this.wrapper) return;

        this.wrapper.addEventListener('animationiteration', () => {
          this.wrapper.style.animation = 'none';
          setTimeout(() => {
            this.wrapper.style.animation = '';
          }, 10);
        });
      }
    }

    customElements.define('auto-carousel-{{ ai_gen_id }}', AutoCarousel{{ ai_gen_id }});
  })();
</script>

