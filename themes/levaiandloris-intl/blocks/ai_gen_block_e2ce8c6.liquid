{% doc %}
  @prompt
    make a version of the videos section following this one but allow scrolling on mobile devices left and right by swiping left and right

    Update: add a thumbnail image to each video that shows before the video is played, and load/play the video only when the thumbnail is clicked
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-swipe-videos-{{ ai_gen_id }} {
    width: 100%;
    display: block;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-swipe-videos__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.desktop_width_percent }}%;
    margin: 0 auto;
  }

  .ai-swipe-videos__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: 32px;
    padding: 0 20px;
  }

  .ai-swipe-videos__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 12px 0;
    font-weight: 600;
  }

  .ai-swipe-videos__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-swipe-videos__scroll-container-{{ ai_gen_id }} {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0 20px 20px;
  }

  .ai-swipe-videos__scroll-container-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-swipe-videos__grid-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.video_gap }}px;
    width: max-content;
  }

  .ai-swipe-videos__item-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.video_width_mobile }}px;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 }});
  }

  .ai-swipe-videos__video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 177.78%;
    background-color: #000000;
    overflow: hidden;
  }

  .ai-swipe-videos__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-swipe-videos__placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.3;
  }

  .ai-swipe-videos__poster-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #000000;
    border: 0;
    padding: 0;
    margin: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .ai-swipe-videos__poster-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-swipe-videos__play-button-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }

  .ai-swipe-videos__poster-{{ ai_gen_id }}:hover .ai-swipe-videos__play-button-{{ ai_gen_id }},
  .ai-swipe-videos__poster-{{ ai_gen_id }}:focus-visible .ai-swipe-videos__play-button-{{ ai_gen_id }} {
    transform: scale(1.08);
  }

  .ai-swipe-videos__play-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    margin-left: 3px;
    color: #1a1a1a;
  }

  .ai-swipe-videos__player-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .ai-swipe-videos__player-{{ ai_gen_id }} video,
  .ai-swipe-videos__player-{{ ai_gen_id }} iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }

  .ai-swipe-videos__content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
  }

  .ai-swipe-videos__video-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.video_title_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 8px 0;
    font-weight: 600;
  }

  .ai-swipe-videos__video-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.video_description_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-swipe-videos__scroll-indicator-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    padding: 0 20px;
  }

  .ai-swipe-videos__dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: {{ block.settings.text_color }};
    opacity: 0.3;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .ai-swipe-videos__dot-{{ ai_gen_id }}.active {
    opacity: 1;
    transform: scale(1.2);
  }

  @media screen and (min-width: 750px) {
    .ai-swipe-videos__item-{{ ai_gen_id }} {
      width: {{ block.settings.video_width_desktop }}px;
    }

    .ai-swipe-videos__grid-{{ ai_gen_id }} {
      justify-content: {{ block.settings.desktop_alignment }};
      width: 100%;
    }

    .ai-swipe-videos__scroll-container-{{ ai_gen_id }} {
      overflow-x: visible;
    }

    .ai-swipe-videos__scroll-indicator-{{ ai_gen_id }} {
      display: none;
    }
  }

  @media screen and (min-width: 990px) {
    .ai-swipe-videos__grid-{{ ai_gen_id }} {
      display: grid;
      grid-template-columns: repeat({{ block.settings.videos_per_row }}, 1fr);
      width: 100%;
    }

    .ai-swipe-videos__item-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<swipe-videos-{{ ai_gen_id }} class="ai-swipe-videos-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-swipe-videos__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subtitle != blank %}
      <div class="ai-swipe-videos__header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-swipe-videos__title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <div class="ai-swipe-videos__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-swipe-videos__scroll-container-{{ ai_gen_id }}" data-scroll-container>
      <div class="ai-swipe-videos__grid-{{ ai_gen_id }}">
        {% for i in (1..6) %}
          {% liquid
            assign video_key = 'video_' | append: i
            assign video_title_key = 'video_title_' | append: i
            assign video_description_key = 'video_description_' | append: i
            assign thumbnail_key = 'video_thumbnail_' | append: i
            assign video = block.settings[video_key]
            assign video_title = block.settings[video_title_key]
            assign video_description = block.settings[video_description_key]
            assign custom_thumbnail = block.settings[thumbnail_key]

            assign thumbnail_image = custom_thumbnail
            if thumbnail_image == blank and video != blank
              assign thumbnail_image = video.preview_image
            endif

            assign poster_image_class = 'ai-swipe-videos__poster-image-' | append: ai_gen_id
          %}

          {% if video != blank or video_title != blank or video_description != blank %}
            <div class="ai-swipe-videos__item-{{ ai_gen_id }}">
              <div class="ai-swipe-videos__video-wrapper-{{ ai_gen_id }}">
                {% if video != blank %}
                  <button
                    type="button"
                    class="ai-swipe-videos__poster-{{ ai_gen_id }}"
                    data-video-poster
                    data-video-trigger
                    aria-label="Play video{% if video_title != blank %}: {{ video_title | strip_html }}{% endif %}"
                  >
                    {% if thumbnail_image != blank %}
                      {{
                        thumbnail_image
                        | image_url: width: 600
                        | image_tag:
                          loading: 'lazy',
                          widths: '300, 450, 600',
                          sizes: '(min-width: 750px) 350px, 280px',
                          class: poster_image_class,
                          alt: ''
                      }}
                    {% endif %}
                    <span class="ai-swipe-videos__play-button-{{ ai_gen_id }}" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M8 5v14l11-7z"></path>
                      </svg>
                    </span>
                  </button>

                  <div
                    class="ai-swipe-videos__player-{{ ai_gen_id }}"
                    data-video-player
                    data-video-type="{{ video.type }}"
                    data-video-id="{{ video.id }}"
                    data-video-title="{{ video_title | strip_html | escape }}"
                    hidden
                  >
                    {% if video.type == blank %}
                      {{
                        video
                        | video_tag:
                          image_size: '600x',
                          autoplay: false,
                          loop: false,
                          controls: true,
                          muted: false,
                          preload: 'none'
                      }}
                    {% endif %}
                  </div>
                {% else %}
                  <div class="ai-swipe-videos__placeholder-{{ ai_gen_id }}">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                  </div>
                {% endif %}
              </div>

              {% if video_title != blank or video_description != blank %}
                <div class="ai-swipe-videos__content-{{ ai_gen_id }}">
                  {% if video_title != blank %}
                    <h3 class="ai-swipe-videos__video-title-{{ ai_gen_id }}">{{ video_title }}</h3>
                  {% endif %}
                  {% if video_description != blank %}
                    <div class="ai-swipe-videos__video-description-{{ ai_gen_id }}">{{ video_description }}</div>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="ai-swipe-videos__scroll-indicator-{{ ai_gen_id }}" data-scroll-indicator></div>
  </div>
</swipe-videos-{{ ai_gen_id }}>

<script>
  (function() {
    class SwipeVideos{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.scrollContainer = null;
        this.scrollIndicator = null;
        this.dots = [];
        this.videoItems = [];
      }

      connectedCallback() {
        this.scrollContainer = this.querySelector('[data-scroll-container]');
        this.scrollIndicator = this.querySelector('[data-scroll-indicator]');
        this.videoItems = Array.from(this.querySelectorAll('.ai-swipe-videos__item-{{ ai_gen_id }}'));

        if (this.scrollContainer && this.scrollIndicator && this.videoItems.length > 0) {
          this.createScrollIndicators();
          this.setupScrollListener();
          this.updateActiveIndicator();
        }

        this.addEventListener('click', this.handleClick.bind(this));
      }

      createScrollIndicators() {
        this.scrollIndicator.innerHTML = '';
        this.dots = [];

        this.videoItems.forEach((item, index) => {
          const dot = document.createElement('div');
          dot.className = 'ai-swipe-videos__dot-{{ ai_gen_id }}';
          dot.setAttribute('data-index', index);
          this.scrollIndicator.appendChild(dot);
          this.dots.push(dot);
        });
      }

      setupScrollListener() {
        let scrollTimeout;
        this.scrollContainer.addEventListener('scroll', () => {
          clearTimeout(scrollTimeout);
          scrollTimeout = setTimeout(() => {
            this.updateActiveIndicator();
          }, 100);
        });
      }

      updateActiveIndicator() {
        if (this.videoItems.length === 0 || this.dots.length === 0) return;

        const scrollLeft = this.scrollContainer.scrollLeft;
        const containerWidth = this.scrollContainer.offsetWidth;

        let activeIndex = 0;
        let minDistance = Infinity;

        this.videoItems.forEach((item, index) => {
          const itemLeft = item.offsetLeft;
          const itemCenter = itemLeft + (item.offsetWidth / 2);
          const viewportCenter = scrollLeft + (containerWidth / 2);
          const distance = Math.abs(itemCenter - viewportCenter);

          if (distance < minDistance) {
            minDistance = distance;
            activeIndex = index;
          }
        });

        this.dots.forEach((dot, index) => {
          if (index === activeIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      handleClick(event) {
        const trigger = event.target.closest('[data-video-trigger]');
        if (!trigger) return;

        const item = trigger.closest('.ai-swipe-videos__item-{{ ai_gen_id }}');
        if (!item) return;

        this.playVideo(item);
      }

      playVideo(item) {
        this.videoItems.forEach((otherItem) => {
          if (otherItem !== item) this.resetVideo(otherItem);
        });

        const poster = item.querySelector('[data-video-poster]');
        const player = item.querySelector('[data-video-player]');
        if (!player) return;

        const type = player.getAttribute('data-video-type');
        const videoId = player.getAttribute('data-video-id');
        const title = player.getAttribute('data-video-title') || '';

        if (type === 'youtube' && !player.dataset.loaded) {
          const iframe = document.createElement('iframe');
          iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&playsinline=1&rel=0&modestbranding=1`;
          iframe.setAttribute('frameborder', '0');
          iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture');
          iframe.setAttribute('allowfullscreen', '');
          iframe.setAttribute('title', title);
          player.appendChild(iframe);
          player.dataset.loaded = 'true';
        } else if (type === 'vimeo' && !player.dataset.loaded) {
          const iframe = document.createElement('iframe');
          iframe.src = `https://player.vimeo.com/video/${videoId}?title=0&byline=0&portrait=0&autoplay=1`;
          iframe.setAttribute('frameborder', '0');
          iframe.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture');
          iframe.setAttribute('allowfullscreen', '');
          iframe.setAttribute('title', title);
          player.appendChild(iframe);
          player.dataset.loaded = 'true';
        } else if (!type) {
          const videoEl = player.querySelector('video');
          if (videoEl) {
            videoEl.play().catch(() => {});
          }
        }

        if (poster) poster.hidden = true;
        player.hidden = false;
      }

      resetVideo(item) {
        const poster = item.querySelector('[data-video-poster]');
        const player = item.querySelector('[data-video-player]');
        if (!player) return;

        const type = player.getAttribute('data-video-type');

        if ((type === 'youtube' || type === 'vimeo') && player.dataset.loaded) {
          player.innerHTML = '';
          delete player.dataset.loaded;
        } else if (!type) {
          const videoEl = player.querySelector('video');
          if (videoEl) {
            videoEl.pause();
            videoEl.currentTime = 0;
          }
        }

        player.hidden = true;
        if (poster) poster.hidden = false;
      }
    }

    customElements.define('swipe-videos-{{ ai_gen_id }}', SwipeVideos{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Swipeable videos",
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Watch Our Videos"
    },
    {
      "type": "inline_richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Swipe to explore more"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Subtitle size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
