{% doc %}
  @prompt
    build an images carousel slider with the dimensions on 150*150 px , it can contain 5 or more images in desktop and 2 per raw in mobile , the whole section auto scroll from left to right with speed can be adjusted both in desktop and mobile, i can add the images separately
    
    , and it only display the selected images
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-carousel-container-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    position: relative;
    padding: 20px 0;
  }

  .ai-carousel-wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    animation: ai-carousel-scroll-{{ ai_gen_id }} var(--ai-carousel-duration-{{ ai_gen_id }}) linear infinite;
    will-change: transform;
  }

  .ai-carousel-wrapper-{{ ai_gen_id }}:hover {
    animation-play-state: paused;
  }

  .ai-carousel-item-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 150px;
    height: 150px;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    background-color: {{ block.settings.placeholder_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-carousel-item-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-carousel-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.placeholder_bg_color }};
  }

  .ai-carousel-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.3;
  }

  @keyframes ai-carousel-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-150px * var(--ai-carousel-items-{{ ai_gen_id }}) - {{ block.settings.gap }}px * var(--ai-carousel-items-{{ ai_gen_id }})));
    }
  }

  @media screen and (max-width: 749px) {
    .ai-carousel-wrapper-{{ ai_gen_id }} {
      animation: ai-carousel-scroll-mobile-{{ ai_gen_id }} var(--ai-carousel-duration-mobile-{{ ai_gen_id }}) linear infinite;
    }

    @keyframes ai-carousel-scroll-mobile-{{ ai_gen_id }} {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(calc(-150px * var(--ai-carousel-items-{{ ai_gen_id }}) - {{ block.settings.gap }}px * var(--ai-carousel-items-{{ ai_gen_id }})));
      }
    }
  }
{% endstyle %}

<auto-carousel-{{ ai_gen_id }}
  class="ai-carousel-container-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
  data-desktop-speed="{{ block.settings.desktop_speed }}"
  data-mobile-speed="{{ block.settings.mobile_speed }}"
>
  <div class="ai-carousel-wrapper-{{ ai_gen_id }}">
    {% for i in (1..2) %}
      {% if block.settings.image_1 != blank %}
