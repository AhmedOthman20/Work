</auto-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class AutoCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.wrapper = this.querySelector('.ai-carousel-wrapper-{{ ai_gen_id }}');
        this.desktopSpeed = parseFloat(this.dataset.desktopSpeed);
        this.mobileSpeed = parseFloat(this.dataset.mobileSpeed);
        this.calculateDuration();
        window.addEventListener('resize', this.calculateDuration.bind(this));
      }

      calculateDuration() {
        const items = this.querySelectorAll('.ai-carousel-item-{{ ai_gen_id }}');
        const totalItems = items.length / 2;
        const gap = {{ block.settings.gap }};
        const itemWidth = 150;
        const totalWidth = (itemWidth * totalItems) + (gap * totalItems);
        
        const isMobile = window.innerWidth < 750;
        const speed = isMobile ? this.mobileSpeed : this.desktopSpeed;
        const duration = totalWidth / speed;
        
        this.style.setProperty('--ai-carousel-items-{{ ai_gen_id }}', totalItems);
        this.style.setProperty('--ai-carousel-duration-{{ ai_gen_id }}', duration + 's');
        this.style.setProperty('--ai-carousel-duration-mobile-{{ ai_gen_id }}', duration + 's');
      }

      disconnectedCallback() {
        window.removeEventListener('resize', this.calculateDuration.bind(this));
      }
    }

    customElements.define('auto-carousel-{{ ai_gen_id }}', AutoCarousel{{ ai_gen_id }});
  })();
</script>

