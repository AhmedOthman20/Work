{% doc %}
  @prompt
    create a videos carousel  with the videos dimensions of the Instagram reels and the option to add the videos as separate elements also i can link the video to certain product and auto play and show a controller of the volume wither be mute or not for every video and the section can show 5 videos per row with the option to increase it or decrease it also in the mobile view it can be displayed as carousel slider with arrows to navigate right and left and the product widget should contain a small image of the product and to be displayed under each video , make the desktop display as slider carousel can be navigated left and right not a grid , also make the videos height unified  , also adapt to the video's width ,don't change the video dimensions after assigning the product , don't change the video width to adapt to the product title width , you divide the product title into 2 lines and the video can display videos assigned by product Metafields and metaobjects
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-carousel-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
    position: relative;
  }

  .ai-video-carousel__container-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-video-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    transition: transform 0.4s ease;
  }

  .ai-video-carousel__item-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.videos_per_row | minus: 1 }} * {{ block.settings.gap }}px)) / {{ block.settings.videos_per_row }});
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-video-carousel__video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    background-color: #000000;
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
  }

  .ai-video-carousel__video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-carousel__mute-button-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: rgba(0, 0, 0, 0.6);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    transition: background-color 0.3s ease;
    z-index: 2;
  }

  .ai-video-carousel__mute-button-{{ ai_gen_id }}:hover {
    background-color: rgba(0, 0, 0, 0.8);
  }

  .ai-video-carousel__mute-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-video-carousel__product-widget-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px;
    background-color: {{ block.settings.product_widget_bg }};
    border-radius: {{ block.settings.product_widget_border_radius }}px;
    text-decoration: none;
    transition: transform 0.3s ease;
  }

  .ai-video-carousel__product-widget-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
  }

  .ai-video-carousel__product-image-{{ ai_gen_id }} {
    width: 50px;
    height: 50px;
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
  }

  .ai-video-carousel__product-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-carousel__product-info-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
  }

  .ai-video-carousel__product-title-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    color: {{ block.settings.product_widget_text }};
    margin: 0 0 4px 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.3;
  }

  .ai-video-carousel__product-price-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.product_widget_text }};
    opacity: 0.8;
  }

  .ai-video-carousel__nav-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: {{ block.settings.nav_button_bg }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.nav_button_color }};
    transition: all 0.3s ease;
    z-index: 3;
  }

  .ai-video-carousel__nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_bg }};
  }

  .ai-video-carousel__nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-video-carousel__nav-button--prev-{{ ai_gen_id }} {
    left: -24px;
  }

  .ai-video-carousel__nav-button--next-{{ ai_gen_id }} {
    right: -24px;
  }

  .ai-video-carousel__nav-button-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
  }

  .ai-video-carousel__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666666;
  }

  .ai-video-carousel__empty-state-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    margin-bottom: 16px;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-video-carousel__item-{{ ai_gen_id }} {
      flex: 0 0 100%;
    }

    .ai-video-carousel__nav-button--prev-{{ ai_gen_id }} {
      left: 8px;
    }

    .ai-video-carousel__nav-button--next-{{ ai_gen_id }} {
      right: 8px;
    }
  }
{% endstyle %}

<video-carousel-{{ ai_gen_id }}
  class="ai-video-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% assign has_videos = false %}
  {% for i in (1..10) %}
    {% assign video_key = 'video_' | append: i %}
    {% assign product_key = 'product_' | append: i %}
    {% assign video = block.settings[video_key] %}
    {% if video != blank %}
      {% assign has_videos = true %}
      {% break %}
    {% endif %}
  {% endfor %}

  {% if has_videos %}
    <div class="ai-video-carousel__container-{{ ai_gen_id }}">
      <div class="ai-video-carousel__track-{{ ai_gen_id }}">
        {% for i in (1..10) %}
          {% assign video_key = 'video_' | append: i %}
          {% assign product_key = 'product_' | append: i %}
          {% assign video = block.settings[video_key] %}
          {% assign product = block.settings[product_key] %}

          {% if video != blank %}
            <div class="ai-video-carousel__item-{{ ai_gen_id }}" data-video-item>
              <div class="ai-video-carousel__video-wrapper-{{ ai_gen_id }}">
                <video
                  class="ai-video-carousel__video-{{ ai_gen_id }}"
                  {% if block.settings.autoplay %}autoplay{% endif %}
                  loop
                  muted
                  playsinline
                  preload="metadata"
                >
                  <source src="{{ video }}" type="video/mp4">
                </video>

                <button
                  class="ai-video-carousel__mute-button-{{ ai_gen_id }}"
                  aria-label="Toggle mute"
                  data-mute-button
                >
                  <svg class="ai-video-carousel__mute-icon-muted-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                    <line x1="23" y1="9" x2="17" y2="15"></line>
                    <line x1="17" y1="9" x2="23" y2="15"></line>
                  </svg>
                  <svg class="ai-video-carousel__mute-icon-unmuted-{{ ai_gen_id }}" style="display: none;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                  </svg>
                </button>
              </div>

              {% if product != blank %}
                <a
                  href="{{ product.url }}"
                  class="ai-video-carousel__product-widget-{{ ai_gen_id }}"
                >
                  <div class="ai-video-carousel__product-image-{{ ai_gen_id }}">
                    {% if product.featured_image %}
                      <img
                        src="{{ product.featured_image | image_url: width: 100 }}"
                        alt="{{ product.featured_image.alt | escape }}"
                        width="100"
                        height="100"
                        loading="lazy"
                      >
                    {% endif %}
                  </div>
                  <div class="ai-video-carousel__product-info-{{ ai_gen_id }}">
                    <h3 class="ai-video-carousel__product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
                    <div class="ai-video-carousel__product-price-{{ ai_gen_id }}">{{ product.price | money }}</div>
                  </div>
                </a>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <button
        class="ai-video-carousel__nav-button-{{ ai_gen_id }} ai-video-carousel__nav-button--prev-{{ ai_gen_id }}"
        aria-label="Previous"
        data-nav-prev
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <button
        class="ai-video-carousel__nav-button-{{ ai_gen_id }} ai-video-carousel__nav-button--next-{{ ai_gen_id }}"
        aria-label="Next"
        data-nav-next
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  {% else %}
    <div class="ai-video-carousel__empty-state-{{ ai_gen_id }}">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="23 7 16 12 23 17 23 7"></polygon>
        <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
      </svg>
      <p>Add videos to get started</p>
    </div>
  {% endif %}
</video-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.videosPerView = {{ block.settings.videos_per_row }};
        this.isMobile = window.innerWidth <= 749;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-video-carousel__track-{{ ai_gen_id }}');
        this.items = this.querySelectorAll('[data-video-item]');
        this.prevButton = this.querySelector('[data-nav-prev]');
        this.nextButton = this.querySelector('[data-nav-next]');
        this.muteButtons = this.querySelectorAll('[data-mute-button]');

        if (!this.track || this.items.length === 0) return;

        this.setupNavigation();
        this.setupMuteButtons();
        this.setupResponsive();
        this.updateNavButtons();
      }

      setupNavigation() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.navigate('prev'));
        }
        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.navigate('next'));
        }
      }

      setupMuteButtons() {
        this.muteButtons.forEach((button, index) => {
          const videoWrapper = button.closest('.ai-video-carousel__video-wrapper-{{ ai_gen_id }}');
          const video = videoWrapper.querySelector('video');
          const mutedIcon = button.querySelector('.ai-video-carousel__mute-icon-muted-{{ ai_gen_id }}');
          const unmutedIcon = button.querySelector('.ai-video-carousel__mute-icon-unmuted-{{ ai_gen_id }}');

          button.addEventListener('click', () => {
            if (video.muted) {
              video.muted = false;
              mutedIcon.style.display = 'none';
              unmutedIcon.style.display = 'block';
            } else {
              video.muted = true;
              mutedIcon.style.display = 'block';
              unmutedIcon.style.display = 'none';
            }
          });
        });
      }

      setupResponsive() {
        window.addEventListener('resize', () => {
          const wasMobile = this.isMobile;
          this.isMobile = window.innerWidth <= 749;
          
          if (wasMobile !== this.isMobile) {
            this.videosPerView = this.isMobile ? 1 : {{ block.settings.videos_per_row }};
            this.currentIndex = 0;
            this.updateCarousel();
          }
        });
      }

      navigate(direction) {
        const maxIndex = this.items.length - this.videosPerView;
        
        if (direction === 'prev') {
          this.currentIndex = Math.max(0, this.currentIndex - 1);
        } else {
          this.currentIndex = Math.min(maxIndex, this.currentIndex + 1);
        }
        
        this.updateCarousel();
      }

      updateCarousel() {
        const itemWidth = this.items[0].offsetWidth;
        const gap = {{ block.settings.gap }};
        const offset = -(this.currentIndex * (itemWidth + gap));
        
        this.track.style.transform = `translateX(${offset}px)`;
        this.updateNavButtons();
      }

      updateNavButtons() {
        const maxIndex = this.items.length - this.videosPerView;
        
        if (this.prevButton) {
          this.prevButton.disabled = this.currentIndex === 0;
        }
        if (this.nextButton) {
          this.nextButton.disabled = this.currentIndex >= maxIndex;
        }
      }
    }

    customElements.define('video-carousel-{{ ai_gen_id }}', VideoCarousel{{ ai_gen_id }});
  })();
</script>

