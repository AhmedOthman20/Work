{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
VARIANT PICKER
----------------------------------------------------------------------------------------------------------------------

Render the variant picker option selectors.

********************************************
Supported variables
********************************************

* product: the product for which to render the selector (required)
* form_id: the ID of the form to which the variant picker belongs (required)
* update_url: if set to true, the URL is updated when the variant changes (usually used for product page)
* hide_sold_out_variants: if set to true, the sold out or unavailable variants are hidden
* hide_size_chart: if set to true, size chart is always hidden
* force_dropdown_as_block: if set to true, the dropdown selectors are replaced by blocks, which is useful for quick buy where dropdown are not convenient to use
* block: the block itself, for theme-specific options (such as selector types)
{%- endcomment -%}

{%- assign color_label_list = 'general.label.color' | t | replace: ', ', ',' | downcase | split: ',' -%}
{%- assign size_label_list = 'general.label.size' | t | replace: ', ', ',' | downcase | split: ',' -%}
{%- assign variant_image_options = block.settings.variant_image_options | replace: ', ', ',' | downcase | split: ',' -%}

{%- unless product.has_only_default_variant -%}
  <variant-picker class="variant-picker" section-id="{{ section.id }}" handle="{{ product.handle }}" form-id="{{ form_id }}" {% if update_url %}update-url{% endif %}>
    {%- comment -%}
    The variant data is outputted as a JSON, which allows the theme to emit an event with the data when the variant changes. This must not be removed.
    {%- endcomment -%}
    <script data-variant type="application/json">
      {{- product.selected_or_first_available_variant | json -}}
    </script>

    {%- for option in product.options_with_values -%}
      {% liquid
        assign option_downcase = option.name | downcase
        assign resolved_option_selector_style = block.settings.selector_style

        assign swatch_count = option.values | map: 'swatch' | compact | size

        if swatch_count > 0 and block.settings.swatch_selector_style != 'none'
          # Use the swatch selector type only if we have at least one swatch and a supported swatch selector type
          assign resolved_option_selector_style = block.settings.swatch_selector_style
        endif

        # Implementation note: if the option value has no native swatch, BUT that the option name matches a hardcoded list of color names,
        # we fallback to the legacy config-based system. This allows to keep compatibility with stores that were using the config-based, and
        # allow those merchants to upgrade to the new system at their own pace.
        if swatch_count == 0 and color_label_list contains option_downcase and block.settings.swatch_selector_style != 'none'
          assign resolved_option_selector_style = block.settings.swatch_selector_style
        endif

        if resolved_option_selector_style == 'dropdown' and force_dropdown_as_block
          assign resolved_option_selector_style = 'block'
        endif

        if variant_image_options contains option_downcase
          assign resolved_option_selector_style = 'variant_image'
        endif
      %}

      <fieldset class="variant-picker__option">
        <div class="variant-picker__option-info">
          <div class="h-stack gap-2">
            <legend class="text-subdued">{{ option.name }}:</legend>
            <span>{{ option.selected_value }}</span>
          </div>

          {%- if hide_size_chart != true and size_label_list contains option_downcase and block.settings.show_size_guide != false -%}
            {%- capture drawer_id -%}size-chart-{{ option.position }}-{{ form_id }}{%- endcapture -%}

            <button
              type="button"
              class="text-sm text-subdued"
              aria-controls="{{ drawer_id | escape }}"
              aria-expanded="false"
              data-size-modal-open
            >
              <span class="link">{{ block.settings.size_guide_label | default: 'Size Guide' }}</span>
            </button>

      <div class="size-modal" id="{{ drawer_id }}" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="{{ drawer_id }}-title">
        <div class="size-modal__overlay js-close-size-modal"></div>
        <div class="size-modal__content" style="
          --modal-title-size-desktop: {{ block.settings.modal_title_size_desktop | default: 22 }}px;
          --modal-title-size-mobile: {{ block.settings.modal_title_size_mobile | default: 18 }}px;
          --modal-subtitle-size-desktop: {{ block.settings.modal_subtitle_size_desktop | default: 14 }}px;
          --modal-subtitle-size-mobile: {{ block.settings.modal_subtitle_size_mobile | default: 13 }}px;
          --modal-body-size-desktop: {{ block.settings.modal_body_size_desktop | default: 14 }}px;
          --modal-body-size-mobile: {{ block.settings.modal_body_size_mobile | default: 13 }}px;
          --modal-table-header-size-desktop: {{ block.settings.modal_table_header_size_desktop | default: 13 }}px;
          --modal-table-header-size-mobile: {{ block.settings.modal_table_header_size_mobile | default: 12 }}px;
          --modal-table-cell-size-desktop: {{ block.settings.modal_table_cell_size_desktop | default: 13 }}px;
          --modal-table-cell-size-mobile: {{ block.settings.modal_table_cell_size_mobile | default: 12 }}px;
        ">
          <button type="button" class="size-modal__close js-close-size-modal" aria-label="Close modal">&times;</button>

          <div class="size-modal__header">
            <h2 id="{{ drawer_id }}-title" class="size-modal__title">{{ block.settings.modal_title | default: block.settings.size_chart_page.title | default: 'Size Guide' }}</h2>
            {%- if block.settings.modal_subtitle != blank -%}
              <p class="size-modal__subtitle">{{ block.settings.modal_subtitle }}</p>
            {%- endif -%}
          </div>

          <div class="size-modal__body">
            {%- if block.settings.modal_intro_text != blank -%}
              <div class="size-modal__intro-text size-modal__rich-text">
                {{ block.settings.modal_intro_text }}
              </div>
            {%- elsif block.settings.size_chart_page.content != blank -%}
              <div class="size-modal__intro-text size-modal__rich-text prose">
                {{ block.settings.size_chart_page.content }}
              </div>
            {%- endif -%}

            {%- if block.settings.size_guide_image != blank -%}
              <div class="size-modal__image-wrapper">
                {{-
                  block.settings.size_guide_image
                  | image_url: width: 1800
                  | image_tag:
                    class: 'size-modal__image',
                    loading: 'lazy',
                    widths: '480, 720, 960, 1200, 1800',
                    sizes: '(max-width: 749px) calc(100vw - 64px), 520px',
                    alt: block.settings.modal_title
                -}}
              </div>
            {%- else -%}
              <div class="size-modal__table-wrapper">
              <table class="size-modal__table">
                <thead>
                  <tr>
                    <th></th>
                    {%- if block.settings.table_col_1 != blank -%}<th>{{ block.settings.table_col_1 }}</th>{%- endif -%}
                    {%- if block.settings.table_col_2 != blank -%}<th>{{ block.settings.table_col_2 }}</th>{%- endif -%}
                    {%- if block.settings.table_col_3 != blank -%}<th>{{ block.settings.table_col_3 }}</th>{%- endif -%}
                    {%- if block.settings.table_col_4 != blank -%}<th>{{ block.settings.table_col_4 }}</th>{%- endif -%}
                    {%- if block.settings.table_col_5 != blank -%}<th>{{ block.settings.table_col_5 }}</th>{%- endif -%}
                  </tr>
                </thead>
                <tbody>
                  {%- if block.settings.table_row_1_label != blank -%}
                    <tr class="highlight">
                      <td>{{ block.settings.table_row_1_label }}</td>
                      {%- if block.settings.table_col_1 != blank -%}<td>{{ block.settings.table_row_1_col_1 }}</td>{%- endif -%}
                      {%- if block.settings.table_col_2 != blank -%}<td>{{ block.settings.table_row_1_col_2 }}</td>{%- endif -%}
                      {%- if block.settings.table_col_3 != blank -%}<td>{{ block.settings.table_row_1_col_3 }}</td>{%- endif -%}
                      {%- if block.settings.table_col_4 != blank -%}<td>{{ block.settings.table_row_1_col_4 }}</td>{%- endif -%}
                      {%- if block.settings.table_col_5 != blank -%}<td>{{ block.settings.table_row_1_col_5 }}</td>{%- endif -%}
                    </tr>
                  {%- endif -%}
                  {%- if block.settings.table_row_2_label != blank -%}
                    <tr>
                      <td>{{ block.settings.table_row_2_label }}</td>
                      {%- if block.settings.table_col_1 != blank -%}<td>{{ block.settings.table_row_2_col_1 }}</td>{%- endif -%}
                      {%- if block.settings.table_col_2 != blank -%}<td>{{ block.settings.table_row_2_col_2 }}</td>{%- endif -%}
                      {%- if block.settings.table_col_3 != blank -%}<td>{{ block.settings.table_row_2_col_3 }}</td>{%- endif -%}
                      {%- if block.settings.table_col_4 != blank -%}<td>{{ block.settings.table_row_2_col_4 }}</td>{%- endif -%}
                      {%- if block.settings.table_col_5 != blank -%}<td>{{ block.settings.table_row_2_col_5 }}</td>{%- endif -%}
                    </tr>
                  {%- endif -%}
                  {%- if block.settings.table_row_3_label != blank -%}
                    <tr class="highlight">
                      <td>{{ block.settings.table_row_3_label }}</td>
                      {%- if block.settings.table_col_1 != blank -%}<td>{{ block.settings.table_row_3_col_1 }}</td>{%- endif -%}
                      {%- if block.settings.table_col_2 != blank -%}<td>{{ block.settings.table_row_3_col_2 }}</td>{%- endif -%}
                      {%- if block.settings.table_col_3 != blank -%}<td>{{ block.settings.table_row_3_col_3 }}</td>{%- endif -%}
                      {%- if block.settings.table_col_4 != blank -%}<td>{{ block.settings.table_row_3_col_4 }}</td>{%- endif -%}
                      {%- if block.settings.table_col_5 != blank -%}<td>{{ block.settings.table_row_3_col_5 }}</td>{%- endif -%}
                    </tr>
                  {%- endif -%}
                  {%- if block.settings.table_row_4_label != blank -%}
                    <tr>
                      <td>{{ block.settings.table_row_4_label }}</td>
                      {%- if block.settings.table_col_1 != blank -%}<td>{{ block.settings.table_row_4_col_1 }}</td>{%- endif -%}
                      {%- if block.settings.table_col_2 != blank -%}<td>{{ block.settings.table_row_4_col_2 }}</td>{%- endif -%}
                      {%- if block.settings.table_col_3 != blank -%}<td>{{ block.settings.table_row_4_col_3 }}</td>{%- endif -%}
                      {%- if block.settings.table_col_4 != blank -%}<td>{{ block.settings.table_row_4_col_4 }}</td>{%- endif -%}
                      {%- if block.settings.table_col_5 != blank -%}<td>{{ block.settings.table_row_4_col_5 }}</td>{%- endif -%}
                    </tr>
                  {%- endif -%}
                  {%- if block.settings.table_row_5_label != blank -%}
                    <tr class="highlight">
                      <td>{{ block.settings.table_row_5_label }}</td>
                      {%- if block.settings.table_col_1 != blank -%}<td>{{ block.settings.table_row_5_col_1 }}</td>{%- endif -%}
                      {%- if block.settings.table_col_2 != blank -%}<td>{{ block.settings.table_row_5_col_2 }}</td>{%- endif -%}
                      {%- if block.settings.table_col_3 != blank -%}<td>{{ block.settings.table_row_5_col_3 }}</td>{%- endif -%}
                      {%- if block.settings.table_col_4 != blank -%}<td>{{ block.settings.table_row_5_col_4 }}</td>{%- endif -%}
                      {%- if block.settings.table_col_5 != blank -%}<td>{{ block.settings.table_row_5_col_5 }}</td>{%- endif -%}
                    </tr>
                  {%- endif -%}
                </tbody>
              </table>
              </div>
            {%- endif -%}

            {%- if block.settings.modal_footer_text != blank -%}
              <div class="size-modal__footer-text size-modal__rich-text">
                {{ block.settings.modal_footer_text }}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
          {%- endif -%}
        </div>

        {%- if resolved_option_selector_style == 'dropdown' -%}
          {%- capture popover_id -%}popover-variant-picker-{{ section.id }}-{{ product.id }}-{{ option.position }}{%- endcapture -%}

          <div class="relative">
            <button type="button" class="select" aria-controls="{{ popover_id }}" aria-expanded="false">
              <span id="{{ popover_id }}-selected-value">{{- option.selected_value -}}</span>
              {%- render 'icon' with 'chevron-bottom', class: 'select-chevron' -%}
            </button>

            <x-popover id="{{ popover_id }}" class="popover" initial-focus="[aria-selected='true']" close-on-listbox-select anchor-horizontal="start" anchor-vertical="end">
              <p class="h5" slot="title">{{ option.name }}</p>

              {%- assign param_name = form_id | append: '-option' | append: option.position -%}

              <div data-option-selector class="popover-listbox">
                {%- for option_value in option.values -%}
                  {%- if hide_sold_out_variants == false or option_value.available or option_value.selected -%}
                    {%- if update_url and option_value.product_url != blank -%}
                      {%- if option_value.selected -%}
                        <input class="sr-only" type="radio" id="{{ param_name }}-{{ option_value.id }}" form="{{ form_id }}" name="{{ param_name }}" data-option-position="{{ option.position }}" value="{{ option_value.id }}" checked>
                      {%- endif -%}

                      <a href="{{ option_value.variant.url | default: option_value.product_url }}" class="popover-listbox__option {% unless option_value.available %}is-disabled{% endunless %}">
                        {{- option_value.name -}}
                      </a>
                    {%- else -%}
                      <label class="popover-listbox__option {% unless option_value.available %}is-disabled{% endunless %}" for="{{ param_name }}-{{ option_value.id }}">
                        <input class="sr-only" form="{{ form_id }}" type="radio" id="{{ param_name }}-{{ option_value.id }}" name="{{ param_name }}" {% if option_value.product_url != blank %}data-product-url="{{ option_value.product_url | escape }}"{% endif %} data-option-position="{{ option.position }}" value="{{ option_value.id }}" {% if option_value.selected %}checked{% endif %}>

                        {{- option_value.name -}}
                      </label>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </x-popover>
          </div>
        {%- else -%}
          <div {% unless block.settings.stack_blocks %}class="scroll-area bleed sm:unbleed"{% endunless %}>
            <div class="variant-picker__option-values {% if block.settings.stack_blocks %}wrap{% else %}scroll-area bleed sm:unbleed{% endif %} {% if resolved_option_selector_style == 'swatch' and settings.color_swatch_style == 'rectangle' %}variant-picker__option-values--color gap-4{% else %}gap-2{% endif %}">
              {% liquid
                assign name = form_id | append: '-option' | append: option.position

                for option_value in option.values
                  case resolved_option_selector_style
                    when 'variant_image'
                      render 'option-value', type: 'thumbnail', form: form_id, option_value: option_value, param_name: name, option_position: option.position, hide_if_disabled: hide_sold_out_variants, reload_page_for_combined_products: update_url, id_prefix: forloop.index, bordered: true
                    when 'swatch'
                      render 'option-value', type: 'swatch', form: form_id, option_value: option_value, param_name: name, option_position: option.position, hide_if_disabled: hide_sold_out_variants, reload_page_for_combined_products: update_url, id_prefix: forloop.index
                    when 'block'
                      render 'option-value', type: 'block', form: form_id, option_value: option_value, param_name: name, option_position: option.position, hide_if_disabled: hide_sold_out_variants, reload_page_for_combined_products: update_url, id_prefix: forloop.index
                    when 'block_swatch'
                      render 'option-value', type: 'block', form: form_id, option_value: option_value, param_name: name, option_position: option.position, show_swatch: true, hide_if_disabled: hide_sold_out_variants, reload_page_for_combined_products: update_url, id_prefix: forloop.index
                  endcase
                endfor
              %}
            </div>
          </div>
        {%- endif -%}
      </fieldset>
    {%- endfor -%}
  </variant-picker>
{%- endunless -%}

<style>
/* ── Modal ── */
  .size-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    visibility: hidden;
    opacity: 0;
    transition: all 0.3s ease;
  }

  .size-modal[aria-hidden="false"] {
    visibility: visible;
    opacity: 1;
  }

  .size-modal__overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.4);
  }

  .size-modal__content {
    position: relative;
    background: white;
    width: 90%;
    max-width: 600px;
    padding: 40px;
    max-height: 80vh;
    overflow-y: auto;
  }

  .size-modal__close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: none;
    border: none;
    font-size: 24px;
    cursor: pointer;
    line-height: 1;
    padding: 4px 8px;
  }

  /* ── Modal Typography — Desktop defaults via CSS variables ── */
  .size-modal__title {
    font-size: var(--modal-title-size-desktop, 22px);
    margin: 0 0 8px;
  }

  .size-modal__subtitle {
    font-size: var(--modal-subtitle-size-desktop, 14px);
    margin: 0 0 16px;
    color: #555;
  }

  .size-modal__rich-text {
    font-size: var(--modal-body-size-desktop, 14px);
    line-height: 1.6;
    margin: 16px 0;
  }

  .size-modal__rich-text p { margin: 0 0 10px; }
  .size-modal__rich-text p:last-child { margin-bottom: 0; }

  /* ── Table ── */
  .size-modal__table-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .size-modal__image-wrapper {
    margin-top: 20px;
  }

  .size-modal__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .size-modal__table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
  }

  .size-modal__table th {
    font-size: var(--modal-table-header-size-desktop, 13px);
    text-align: left;
    padding: 8px 12px;
    border-bottom: 2px solid #111;
    white-space: nowrap;
  }

  .size-modal__table td {
    font-size: var(--modal-table-cell-size-desktop, 13px);
    padding: 8px 12px;
    border-bottom: 1px solid #e5e5e5;
    white-space: nowrap;
  }

  .size-modal__table tr.highlight td {
    background-color: #f4f4f4;
  }

  .size-modal__footer-text {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid #e5e5e5;
  }

  /* ── Mobile Overrides ── */
  @media screen and (max-width: 749px) {
    .size-picker__label {
      height: 30px;
      width: 60px;
    }

    .size-modal__content {
      padding: 28px 20px;
    }

    .size-modal__title {
      font-size: var(--modal-title-size-mobile, 18px);
    }

    .size-modal__subtitle {
      font-size: var(--modal-subtitle-size-mobile, 13px);
    }

    .size-modal__rich-text {
      font-size: var(--modal-body-size-mobile, 13px);
    }

    .size-modal__table th {
      font-size: var(--modal-table-header-size-mobile, 12px);
      padding: 6px 8px;
    }

    .size-modal__table td {
      font-size: var(--modal-table-cell-size-mobile, 12px);
      padding: 6px 8px;
    }
  }
</style>

<script>
  (() => {
    document.querySelectorAll('[data-size-modal-open]').forEach((openButton) => {
      if (openButton.dataset.sizeModalReady === 'true') return;

      const modal = document.getElementById(openButton.getAttribute('aria-controls'));
      if (!modal) return;

      let previousFocus = null;
      const closeButtons = modal.querySelectorAll('.js-close-size-modal');

      const openModal = () => {
        previousFocus = document.activeElement;
        modal.setAttribute('aria-hidden', 'false');
        openButton.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
        modal.querySelector('.size-modal__close')?.focus();
      };

      const closeModal = () => {
        modal.setAttribute('aria-hidden', 'true');
        openButton.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
        previousFocus?.focus();
      };

      openButton.addEventListener('click', openModal);
      closeButtons.forEach((button) => button.addEventListener('click', closeModal));

      modal.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeModal();
      });

      openButton.dataset.sizeModalReady = 'true';
    });
  })();
</script>
