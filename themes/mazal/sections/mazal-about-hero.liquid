{%- comment -%}
  Section contract.
  Mazal About hero (Figma: About Us 1:1850 desktop, 6:3491 mobile).
  Full-width image with an uppercase Cormorant title and a short paragraph in the bottom-left corner.
  @example
  <!-- templates/page.about.json, first section -->
{%- endcomment -%}
<div class="section-background"></div>
<div
  class="section mazal-ah"
  style="
    --mazal-ah-height: {{ section.settings.height }}px;
    --mazal-ah-height-mobile: {{ section.settings.height_mobile }}px;
    --mazal-ah-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  "
>
  <div class="mazal-ah__media">
    {%- if section.settings.image -%}
      {{
        section.settings.image
        | image_url: width: 3000
        | image_tag:
          widths: '430, 750, 1100, 1500, 2000, 3000',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          class: 'mazal-ah__image'
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'mazal-ah__image' }}
    {%- endif -%}
  </div>
  <div class="mazal-ah__content">
    {%- if section.settings.title != blank -%}
      <h1 class="mazal-ah__title">{{ section.settings.title }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="mazal-ah__text">{{ section.settings.text }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .mazal-ah {
    position: relative;
    height: var(--mazal-ah-height);
    overflow: hidden;
    color: #fff;
  }

  .mazal-ah__media,
  .mazal-ah__media::after {
    position: absolute;
    inset: 0;
  }

  .mazal-ah__media::after {
    content: '';
    background: rgb(0 0 0 / var(--mazal-ah-overlay));
  }

  .mazal-ah__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mazal-ah__content {
    position: absolute;
    inset-inline: 64px;
    inset-block-end: 64px;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 640px;
  }

  .mazal-ah__title {
    margin: 0;
    color: #fff;
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 48px;
    line-height: 1.21;
    letter-spacing: normal;
    text-transform: uppercase;
  }

  .mazal-ah__text {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 14px;
    line-height: 1.45;
  }

  @media screen and (max-width: 749px) {
    .mazal-ah {
      height: var(--mazal-ah-height-mobile);
    }

    .mazal-ah__content {
      inset-inline: 16px;
      inset-block-end: 24px;
    }

    .mazal-ah__title {
      font-size: 24px;
    }

    .mazal-ah__text {
      font-size: 10px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mazal about hero",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "overlay_opacity", "label": "Darken image", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 0 },
    { "type": "text", "id": "title", "label": "Title", "default": "MADE FOR THE WAY YOU LIVE." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "At Mazal, we believe everyday essentials deserve thoughtful design. From carefully chosen fabrics to timeless patterns, we create pieces that bring comfort, character, and a little more beauty into your everyday rituals." },
    { "type": "range", "id": "height", "label": "Height (desktop)", "min": 400, "max": 800, "step": 4, "unit": "px", "default": 724 },
    { "type": "range", "id": "height_mobile", "label": "Height (phones)", "min": 240, "max": 640, "step": 4, "unit": "px", "default": 424 }
  ],
  "presets": [{ "name": "Mazal about hero" }]
}
{% endschema %}
