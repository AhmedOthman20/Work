{% javascript %}
  class MazalCollection extends HTMLElement {
    connectedCallback() {
      this.controller = new AbortController();
      const { signal } = this.controller;

      this.panel = this.querySelector('[data-filters]');
      this.toggleButton = this.querySelector('[data-filters-toggle]');
      this.mobileQuery = window.matchMedia('(max-width: 749px)');
      this.toggleButton?.addEventListener('click', () => this.setFiltersOpen(!this.classList.contains('is-filters-open')), { signal });
      this.querySelector('[data-filters-close]')?.addEventListener('click', () => this.setFiltersOpen(false), { signal });
      /* Phones: tapping the dimmed area outside the popup closes it. */
      this.panel?.addEventListener(
        'click',
        (event) => {
          if (event.target === this.panel) this.setFiltersOpen(false);
        },
        { signal }
      );
      document.addEventListener(
        'keydown',
        (event) => {
          if (event.key === 'Escape' && this.classList.contains('is-filters-open')) {
            this.setFiltersOpen(false);
            this.toggleButton?.focus();
          }
        },
        { signal }
      );
      this.mobileQuery.addEventListener('change', () => this.lockScroll(), { signal });

      this.querySelector('[data-filter-search]')?.addEventListener('input', (event) => this.searchFilters(event.target.value), { signal });
      this.querySelectorAll('[data-range]').forEach((range) => this.setupRange(range, signal));

      this.addEventListener('submit', (event) => this.onSubmit(event), { signal });
      this.setupInfiniteLoad();
    }

    disconnectedCallback() {
      this.controller?.abort();
      this.observer?.disconnect();
      document.documentElement.style.removeProperty('overflow');
    }

    setFiltersOpen(open) {
      this.classList.toggle('is-filters-open', open);
      this.toggleButton?.setAttribute('aria-expanded', String(open));
      this.lockScroll();
      if (open && this.mobileQuery.matches) {
        this.querySelector('[data-filters-close]')?.focus({ preventScroll: true });
      }
    }

    /* The phone popup keeps the page behind it still. */
    lockScroll() {
      const lock = this.classList.contains('is-filters-open') && this.mobileQuery.matches;
      document.documentElement.style.overflow = lock ? 'hidden' : '';
    }

    /* Search box in the phone popup: hides options (and empty groups) that don't match. */
    searchFilters(query) {
      const term = query.trim().toLowerCase();
      this.querySelectorAll('[data-filter-group]').forEach((group) => {
        let visible = 0;
        group.querySelectorAll('[data-filter-option]').forEach((option) => {
          const match = !term || option.textContent.toLowerCase().includes(term);
          option.hidden = !match;
          if (match) visible += 1;
        });
        group.hidden = visible === 0;
      });
    }

    /* Two-thumb price slider. The hidden inputs are only sent when the range is narrowed. */
    setupRange(range, signal) {
      const max = Number(range.dataset.max) || 0;
      const currency = range.dataset.currency || '';
      const minSlider = range.querySelector('[data-range-min]');
      const maxSlider = range.querySelector('[data-range-max]');
      const minInput = range.querySelector('[data-range-min-input]');
      const maxInput = range.querySelector('[data-range-max-input]');
      const fill = range.querySelector('[data-range-fill]');
      const minLabel = range.querySelector('[data-range-min-label]');
      const maxLabel = range.querySelector('[data-range-max-label]');
      if (!minSlider || !maxSlider) return;
      const format = (value) =>
        `${currency} ${Number(value).toLocaleString('en-US', { maximumFractionDigits: 2 })}`.trim();

      const update = (changed) => {
        let low = Number(minSlider.value);
        let high = Number(maxSlider.value);
        if (low > high) {
          if (changed === minSlider) low = high;
          else high = low;
          minSlider.value = String(low);
          maxSlider.value = String(high);
        }
        if (fill && max > 0) {
          fill.style.insetInlineStart = `${(low / max) * 100}%`;
          fill.style.insetInlineEnd = `${100 - (high / max) * 100}%`;
        }
        if (minLabel) minLabel.textContent = format(low);
        if (maxLabel) maxLabel.textContent = format(high);
        if (minInput) {
          minInput.value = String(low);
          minInput.disabled = low <= 0;
        }
        if (maxInput) {
          maxInput.value = String(high);
          maxInput.disabled = high >= max;
        }
        /* Keep the thumb that was moved on top so it can be dragged back. */
        minSlider.style.zIndex = low >= max - 1 ? '2' : '';
      };

      minSlider.addEventListener('input', () => update(minSlider), { signal });
      maxSlider.addEventListener('input', () => update(maxSlider), { signal });
      update();
    }

    /* Loads the next page when the count / progress bar comes into view. The link stays as a fallback. */
    setupInfiniteLoad() {
      const count = this.querySelector('[data-count]');
      if (!count || !count.dataset.nextUrl) return;
      this.querySelector('[data-more]')?.addEventListener(
        'click',
        (event) => {
          event.preventDefault();
          this.loadMore();
        },
        { signal: this.controller.signal }
      );
      if (!('IntersectionObserver' in window)) return;
      this.observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) this.loadMore();
        },
        { rootMargin: '0px 0px 400px 0px' }
      );
      this.observer.observe(count);
    }

    async loadMore() {
      const count = this.querySelector('[data-count]');
      const nextUrl = count?.dataset.nextUrl;
      if (!nextUrl || this.loading) return;
      this.loading = true;
      count.classList.add('is-loading');
      try {
        const url = new URL(nextUrl, window.location.origin);
        url.searchParams.set('section_id', this.dataset.sectionId);
        const response = await fetch(url, { signal: this.controller.signal });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const html = new DOMParser().parseFromString(await response.text(), 'text/html');
        const items = html.querySelectorAll('[data-grid] > li');
        this.querySelector('[data-grid]')?.append(...items);

        const nextCount = html.querySelector('[data-count]');
        const shown = this.querySelectorAll('[data-grid] > li').length;
        const total = Number(count.dataset.total) || shown;
        const shownLabel = count.querySelector('[data-shown]');
        if (shownLabel) shownLabel.textContent = String(shown);
        const bar = count.querySelector('[data-progress]');
        if (bar) bar.style.width = `${Math.min(100, (shown / total) * 100)}%`;

        const next = nextCount?.dataset.nextUrl;
        if (next) {
          count.dataset.nextUrl = next;
          const link = count.querySelector('[data-more]');
          if (link) link.href = next;
        } else {
          delete count.dataset.nextUrl;
          count.querySelector('[data-more]')?.remove();
          this.observer?.disconnect();
        }
      } catch (error) {
        if (error.name !== 'AbortError') {
          console.error(error);
          window.location.href = nextUrl;
        }
      } finally {
        this.loading = false;
        count.classList.remove('is-loading');
        /* Still in view (short pages): keep going. */
        const rect = count.getBoundingClientRect();
        if (count.dataset.nextUrl && rect.top < window.innerHeight + 400) this.loadMore();
      }
    }

    async onSubmit(event) {
      const form = event.target;
      if (!(form instanceof HTMLFormElement) || !form.hasAttribute('data-col-add')) return;
      event.preventDefault();
      const button = form.querySelector('button');
      button?.setAttribute('aria-busy', 'true');
      try {
        const { CartLinesUpdateEvent } = await import('@shopify/events');
        const formData = new FormData(form);
        const sectionIds = Array.from(document.querySelectorAll('cart-items-component'))
          .map((element) => element.dataset.sectionId)
          .filter(Boolean);
        if (sectionIds.length) formData.append('sections', sectionIds.join(','));

        const deferred = CartLinesUpdateEvent.createPromise();
        this.dispatchEvent(
          new CartLinesUpdateEvent({
            action: 'add',
            context: 'product',
            lines: [{ merchandiseId: String(formData.get('id')), quantity: 1 }],
            promise: deferred.promise,
          })
        );

        const addUrl = (window.Theme && window.Theme.routes && window.Theme.routes.cart_add_url) || form.action;
        const response = await fetch(addUrl, {
          method: 'POST',
          headers: { Accept: 'application/javascript', 'X-Requested-With': 'XMLHttpRequest' },
          body: formData,
        }).then((result) => result.json());

        const cartItems = document.querySelector('cart-items-component');
        let cart;
        if (cartItems && typeof cartItems.fetchCartData === 'function') {
          await customElements.whenDefined('cart-items-component');
          cart = await cartItems.fetchCartData();
        } else {
          cart = await fetch('/cart.js', { headers: { Accept: 'application/json' } }).then((result) => result.json());
        }

        deferred.resolve({
          cart: CartLinesUpdateEvent.createCartFromAjaxResponse(cart),
          detail: {
            items: cart.items,
            source: 'mazal-collection',
            sourceId: this.id,
            itemCount: 1,
            sections: response.sections,
            didError: Boolean(response.status),
          },
        });
      } catch (error) {
        console.error(error);
        form.submit();
      } finally {
        button?.removeAttribute('aria-busy');
      }
    }
  }

  if (!customElements.get('mazal-collection')) {
    customElements.define('mazal-collection', MazalCollection);
  }
{% endjavascript %}

{% schema %}
{
  "name": "Mazal shop",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    { "type": "text", "id": "all_title", "label": "Title on the all products page", "default": "All Products", "info": "Other collections show their own title." },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Timeless designs of uncompromising quality, made for home comfort", "info": "Used when the collection has no description." },
    { "type": "text", "id": "categories_label", "label": "Categories label (screen readers)", "default": "Categories" },
    { "type": "header", "content": "Filters" },
    { "type": "checkbox", "id": "enable_filters", "label": "Show filters", "default": true, "info": "Choose filters in the Search & Discovery app." },
    { "type": "checkbox", "id": "enable_sorting", "label": "Show sorting in filters", "default": true },
    { "type": "text", "id": "filters_label", "label": "Filters button", "default": "FILTERS" },
    { "type": "text", "id": "sort_label", "label": "Sort title", "default": "SORT BY" },
    { "type": "text", "id": "price_label", "label": "Price title", "default": "PRICE RANGE", "info": "Empty uses the filter name." },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder (phones)", "default": "Search..." },
    { "type": "text", "id": "close_label", "label": "Close button (phones)", "default": "CLOSE" },
    { "type": "text", "id": "from_label", "label": "Price from", "default": "From" },
    { "type": "text", "id": "to_label", "label": "Price to", "default": "To" },
    { "type": "text", "id": "clear_label", "label": "Clear button", "default": "CLEAR ALL FILTERS" },
    { "type": "text", "id": "apply_label", "label": "Apply button", "default": "APPLY FILTERS" },
