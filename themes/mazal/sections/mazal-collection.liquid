{%- comment -%}
  Section contract.
  Mazal shop / collection page (Figma: Shop 1:1312 desktop, 6:2514 mobile).
  Title + subtitle, category links (blocks) with a FILTERS button that opens a drawer of Shopify
  filters and sorting, a 4-column (2 on phones) grid of product cards, then "Showing X of N products"
  with a progress bar. The next page loads by itself when the bar scrolls into view.
  @example
  <!-- templates/collection.json -->
{%- endcomment -%}
{%- liquid
  assign color_keyword = section.settings.color_option_name | downcase | strip
  if collection.handle == 'all' and section.settings.all_title != blank
    assign page_title = section.settings.all_title
  else
    assign page_title = collection.title
  endif
  assign page_subtitle = collection.description | strip_html | strip
  if page_subtitle == blank
    assign page_subtitle = section.settings.subtitle
  endif
  assign active_filter_count = 0
  for filter in collection.filters
    assign active_filter_count = active_filter_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != null or filter.max_value.value != null
        assign active_filter_count = active_filter_count | plus: 1
      endif
    endif
  endfor
  assign sort_by = collection.sort_by | default: collection.default_sort_by
-%}

<div class="section-background"></div>
<mazal-collection class="mazal-col" data-section-id="{{ section.id }}">
  <div class="mazal-col__header">
    <h1 class="mazal-col__title">{{ page_title | escape }}</h1>
    {%- if page_subtitle != blank -%}
      <p class="mazal-col__subtitle">{{ page_subtitle | escape }}</p>
    {%- endif -%}
  </div>

  <div class="mazal-col__bar">
    <nav class="mazal-col__cats" aria-label="{{ section.settings.categories_label | escape }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign cat = block.settings.collection
          assign cat_label = block.settings.label | default: cat.title
          assign cat_url = cat.url | default: routes.all_products_collection_url
          assign is_active = false
          if cat and cat.handle == collection.handle
            assign is_active = true
          endif
        -%}
        <a
          class="mazal-col__cat{% if is_active %} is-active{% endif %}"
          href="{{ cat_url }}"
          {% if is_active %}aria-current="page"{% endif %}
          {{ block.shopify_attributes }}
        >
          {{- cat_label | escape -}}
        </a>
      {%- endfor -%}
    </nav>

    {%- if section.settings.enable_filters -%}
      <button type="button" class="mazal-col__filters-btn" data-filters-open aria-haspopup="dialog">
        <svg class="mazal-col__plus" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 19.5V4.5M4.5 12h15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <span>{{ section.settings.filters_label | escape }}{% if active_filter_count > 0 %} ({{ active_filter_count }}){% endif %}</span>
      </button>
    {%- endif -%}
  </div>

  {%- paginate collection.products by section.settings.per_page -%}
    {%- liquid
      assign shown_count = paginate.current_offset | plus: collection.products.size
      assign total_count = collection.products_count
      if total_count > 0
        assign progress = shown_count | times: 100.0 | divided_by: total_count
      else
        assign progress = 0
      endif
    -%}

    {%- if collection.products.size == 0 -%}
      <div class="mazal-col__empty">
        <p>{{ section.settings.empty_text | escape }}</p>
        {%- if active_filter_count > 0 -%}
          <a href="{{ collection.url }}?sort_by={{ sort_by }}">{{ section.settings.clear_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="mazal-col__grid" role="list" data-grid>
      {%- for item in collection.products -%}
        {%- liquid
          assign item_variant = item.selected_or_first_available_variant
          assign color_option = null
          for option in item.options_with_values
            assign option_key = option.name | downcase | strip
            if option_key == color_keyword or option_key == 'color' or option_key == 'colour'
              assign color_option = option
              break
            endif
          endfor
          assign show_badge = false
          if section.settings.badge_text != blank
            if section.settings.badge_tag == blank or item.tags contains section.settings.badge_tag
              assign show_badge = true
            endif
          endif
          assign image_loading = 'lazy'
          if paginate.current_page == 1 and forloop.index <= 4
            assign image_loading = 'eager'
          endif
        -%}
        <li class="mazal-col__item">
          <div class="mazal-col__media">
            <a class="mazal-col__media-link" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
              {%- if item.featured_image -%}
                {{
                  item.featured_image
                  | image_url: width: 900
                  | image_tag:
                    widths: '200, 380, 500, 660, 900',
                    sizes: '(min-width: 750px) calc((100vw - 200px) / 4), calc((100vw - 48px) / 2)',
                    loading: image_loading,
                    alt: item.title,
                    class: 'mazal-col__image'
                }}
              {%- else -%}
                {{ 'product-apparel-1' | placeholder_svg_tag: 'mazal-col__image' }}
              {%- endif -%}
            </a>
            {%- if show_badge -%}
              <span class="mazal-col__badge">{{ section.settings.badge_text | escape }}</span>
            {%- endif -%}
            {%- if item.has_only_default_variant and item_variant.available -%}
              {%- form 'product', item, class: 'mazal-col__add-form', data-col-add: '' -%}
                <input type="hidden" name="id" value="{{ item_variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="mazal-col__add" aria-label="{{ section.settings.add_label | escape }}: {{ item.title | escape }}">
                  <span class="mazal-col__add-icon" aria-hidden="true">{{ 'mazal-icon-bag-white.svg' | inline_asset_content }}</span>
                  <span class="mazal-col__add-text">{{ section.settings.add_label | escape }}</span>
                </button>
              {%- endform -%}
            {%- else -%}
              <a class="mazal-col__add" href="{{ item.url }}" aria-label="{{ section.settings.add_label | escape }}: {{ item.title | escape }}">
                <span class="mazal-col__add-icon" aria-hidden="true">{{ 'mazal-icon-bag-white.svg' | inline_asset_content }}</span>
                <span class="mazal-col__add-text">{{ section.settings.add_label | escape }}</span>
              </a>
            {%- endif -%}
          </div>

          <div class="mazal-col__info">
            <a class="mazal-col__name-row" href="{{ item.url }}">
              <span class="mazal-col__name">{{ item.title | escape }}</span>
              <span class="mazal-col__price">{{ item_variant.price | money }}</span>
            </a>
            {%- if color_option and color_option.values.size > 1 -%}
              <div class="mazal-col__colors">
                <span class="mazal-col__dots">
                  {%- for value in color_option.values limit: 3 -%}
                    {%- render 'mazal-swatch', value: value, colors: section.settings.swatch_colors, class: 'mazal-col__dot' -%}
                  {%- endfor -%}
                </span>
                {%- assign more = color_option.values.size | minus: 3 -%}
                {%- if more > 0 and section.settings.more_label != blank -%}
                  <span class="mazal-col__more">{{ section.settings.more_label | replace: '[count]', more }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>

    {%- if total_count > 0 -%}
      <div
        class="mazal-col__count"
        data-count
        data-total="{{ total_count }}"
        {% if paginate.next %}data-next-url="{{ paginate.next.url }}"{% endif %}
      >
        <p class="mazal-col__count-text">
          {%- capture shown_html -%}<span data-shown>{{ shown_count }}</span>{%- endcapture -%}
          {{- section.settings.count_text | escape | replace: '[shown]', shown_html | replace: '[total]', total_count -}}
        </p>
        <div class="mazal-col__progress" aria-hidden="true">
          <span class="mazal-col__progress-bar" style="width: {{ progress }}%;" data-progress></span>
        </div>
        {%- if paginate.next -%}
          <a class="mazal-col__more-link" href="{{ paginate.next.url }}" data-more>{{ section.settings.loading_text | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endpaginate -%}

  {%- if section.settings.enable_filters -%}
    <dialog class="mazal-col__drawer" data-filters aria-label="{{ section.settings.filters_label | escape }}">
      <form class="mazal-col__drawer-form" action="{{ collection.url }}" method="get">
        <div class="mazal-col__drawer-head">
          <p class="mazal-col__drawer-title">{{ section.settings.filters_label | escape }}</p>
          <button type="button" class="mazal-col__drawer-close" data-filters-close aria-label="Close">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </button>
        </div>

        <div class="mazal-col__drawer-body">
          {%- if section.settings.enable_sorting -%}
            <details class="mazal-col__group" open>
              <summary class="mazal-col__group-title">{{ section.settings.sort_label | escape }}</summary>
              <div class="mazal-col__options">
                {%- for option in collection.sort_options -%}
                  <label class="mazal-col__check">
                    <input type="radio" name="sort_by" value="{{ option.value | escape }}" {% if option.value == sort_by %}checked{% endif %}>
                    <span class="mazal-col__box mazal-col__box--round" aria-hidden="true"></span>
                    <span>{{ option.name | escape }}</span>
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endif -%}

          {%- for filter in collection.filters -%}
            <details class="mazal-col__group" {% if filter.active_values.size > 0 or forloop.index <= 2 %}open{% endif %}>
              <summary class="mazal-col__group-title">{{ filter.label | escape }}</summary>
              {%- case filter.type -%}
                {%- when 'price_range' -%}
                  <div class="mazal-col__price-range">
                    <label class="mazal-col__price-field">
                      <span>{{ section.settings.from_label | escape }}</span>
                      <input
                        type="number"
                        inputmode="decimal"
                        min="0"
                        name="{{ filter.min_value.param_name }}"
                        {% if filter.min_value.value != null %}value="{{ filter.min_value.value | money_without_currency | remove: ',' }}"{% endif %}
                        placeholder="0"
                      >
                    </label>
                    <label class="mazal-col__price-field">
                      <span>{{ section.settings.to_label | escape }}</span>
                      <input
                        type="number"
                        inputmode="decimal"
                        min="0"
                        name="{{ filter.max_value.param_name }}"
                        {% if filter.max_value.value != null %}value="{{ filter.max_value.value | money_without_currency | remove: ',' }}"{% endif %}
                        placeholder="{{ filter.range_max | money_without_currency | remove: ',' }}"
                      >
                    </label>
                  </div>
                {%- else -%}
                  <div class="mazal-col__options">
                    {%- for value in filter.values -%}
                      <label class="mazal-col__check{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                        <input
                          type="checkbox"
                          name="{{ value.param_name }}"
                          value="{{ value.value | escape }}"
                          {% if value.active %}checked{% endif %}
                          {% if value.count == 0 and value.active == false %}disabled{% endif %}
                        >
                        {%- if value.swatch.color or value.swatch.image -%}
                          {%- render 'mazal-swatch', value: value, class: 'mazal-col__box mazal-col__box--swatch' -%}
                        {%- else -%}
                          <span class="mazal-col__box" aria-hidden="true"></span>
                        {%- endif -%}
                        <span>{{ value.label | escape }}</span>
                        <span class="mazal-col__option-count">({{ value.count }})</span>
                      </label>
                    {%- endfor -%}
                  </div>
              {%- endcase -%}
            </details>
          {%- endfor -%}
        </div>

        <div class="mazal-col__drawer-foot">
          <a class="mazal-col__clear" href="{{ collection.url }}?sort_by={{ sort_by }}">{{ section.settings.clear_label | escape }}</a>
          <button type="submit" class="mazal-col__apply">{{ section.settings.apply_label | escape }}</button>
        </div>
      </form>
    </dialog>
  {%- endif -%}
</mazal-collection>

{% stylesheet %}
  .mazal-col {
    --mazal-gold: #bb955a;
    --mazal-grey: #a1a1a1;
    display: flex;
    flex-direction: column;
    padding: 64px;
    color: #000;
    font-family: var(--font-body--family);
  }

  /* Title + subtitle (Figma 1:1313) */
  .mazal-col__header {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-block-end: 64px;
  }

  .mazal-col__title {
    margin: 0;
    color: #000;
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 48px;
    line-height: 1.21;
    letter-spacing: normal;
    text-transform: uppercase;
  }

  .mazal-col__subtitle {
    margin: 0;
    font-size: 14px;
    line-height: 1.45;
  }

  /* Categories + filters (Figma 1:1317), then a grey rule */
  .mazal-col__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block-end: 32px;
    margin-block-end: 32px;
    border-block-end: 1px solid var(--mazal-grey);
  }

  .mazal-col__cats {
    display: flex;
    align-items: center;
    gap: 20px;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .mazal-col__cats::-webkit-scrollbar {
    display: none;
  }

  .mazal-col__cat {
    flex-shrink: 0;
    color: var(--mazal-grey);
    font-size: 16px;
    line-height: 1.45;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .mazal-col__cat:hover {
    color: #000;
  }

  .mazal-col__cat.is-active {
    color: #000;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  .mazal-col__filters-btn {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 8px;
    padding: 0;
    border: 0;
    background: none;
    color: #000;
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: 16px;
    line-height: 1.45;
    text-transform: uppercase;
    cursor: pointer;
  }

  .mazal-col__plus {
    display: block;
    width: 24px;
    height: 24px;
  }

  /* Product grid (Figma 1:1319): 4 x 328px cards, 24px columns, 32px rows */
  .mazal-col__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mazal-col__item {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  .mazal-col__media {
    position: relative;
    aspect-ratio: 328 / 424;
    padding: 8px;
    overflow: hidden;
    background: #f7f7f7;
  }

  .mazal-col__media-link {
    position: absolute;
    inset: 8px;
    display: block;
  }

  .mazal-col__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mazal-col__badge {
    position: absolute;
    inset-block-start: 16px;
    inset-inline-start: 16px;
    padding: 8px 16px;
    background: #fff;
    color: #000;
    font-size: 12px;
    line-height: 1;
    text-transform: uppercase;
    pointer-events: none;
  }

  .mazal-col__add-form {
    display: contents;
  }

  /* Add to cart bar sits just below the image and slides up on hover (Figma: top 434 of 424). */
  .mazal-col__add {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 7.5px 16px;
    border: 0;
    background: var(--mazal-gold);
    color: #fff;
    font-family: var(--font-body--family);
    font-size: 12px;
    line-height: 1.45;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
    transform: translateY(100%);
    transition: transform 0.3s ease;
  }

  .mazal-col__media:hover .mazal-col__add,
  .mazal-col__add:focus-visible {
    transform: translateY(0);
  }

  .mazal-col__add[aria-busy='true'] {
    opacity: 0.7;
    pointer-events: none;
  }

  .mazal-col__add-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
  }

  .mazal-col__info {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .mazal-col__name-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    color: #000;
    font-weight: 500;
    font-size: 14px;
    line-height: 1.45;
    text-decoration: none;
    text-transform: uppercase;
  }

  .mazal-col__price {
    flex-shrink: 0;
  }

  .mazal-col__colors {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .mazal-col__dots {
    display: flex;
    gap: 4px;
  }

  .mazal-col__dot {
    display: block;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background-position: center;
    background-size: cover;
    box-shadow: inset 0 0 0 0.5px rgb(0 0 0 / 0.1);
  }

  .mazal-col__more {
    font-size: 12px;
    line-height: 1.2;
  }

  .mazal-col__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding-block: 64px;
    font-size: 14px;
    text-align: center;
  }

  .mazal-col__empty p {
    margin: 0;
  }

  .mazal-col__empty a {
    color: #000;
    text-transform: uppercase;
  }

  /* Products count + progress (Figma 1:1340) */
  .mazal-col__count {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    width: 100%;
    max-width: 624px;
    margin: 32px auto 0;
    font-size: 14px;
    line-height: 1.45;
    text-align: center;
    text-transform: uppercase;
  }

  .mazal-col__count-text {
    margin: 0;
  }

  .mazal-col__progress {
    position: relative;
    width: 100%;
    height: 2px;
    overflow: hidden;
    background: #f7f7f7;
  }

  .mazal-col__progress-bar {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    background: #000;
    transition: width 0.4s ease;
  }

  .mazal-col__more-link {
    color: #000;
    text-decoration: none;
  }

  .mazal-col__count.is-loading .mazal-col__more-link {
    animation: mazal-col-pulse 1.2s ease-in-out infinite;
  }

  @keyframes mazal-col-pulse {
    50% {
      opacity: 0.4;
    }
  }

  /* Filters drawer */
  .mazal-col__drawer {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(420px, 100vw);
    max-width: 100vw;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: #fff;
    color: #000;
    font-family: var(--font-body--family);
  }

  .mazal-col__drawer::backdrop {
    background: rgb(0 0 0 / 0.4);
  }

  .mazal-col__drawer[open] {
    animation: mazal-col-slide 0.3s ease;
  }

  @keyframes mazal-col-slide {
    from {
      transform: translateX(100%);
    }
  }

  .mazal-col__drawer-form {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .mazal-col__drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 32px;
    border-block-end: 1px solid #f7f7f7;
  }

  .mazal-col__drawer-title {
    margin: 0;
    font-weight: 500;
    font-size: 16px;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .mazal-col__drawer-close {
    display: inline-flex;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    background: none;
    color: #000;
    cursor: pointer;
  }

  .mazal-col__drawer-close svg {
    width: 24px;
    height: 24px;
  }

  .mazal-col__drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 8px 32px 24px;
  }

  .mazal-col__group {
    border-block-end: 1px solid #f7f7f7;
  }

  .mazal-col__group-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 20px;
    font-size: 14px;
    line-height: 1.45;
    text-transform: uppercase;
    list-style: none;
    cursor: pointer;
  }

  .mazal-col__group-title::-webkit-details-marker {
    display: none;
  }

  .mazal-col__group-title::after {
    content: '+';
    font-size: 18px;
    line-height: 1;
  }

  .mazal-col__group[open] > .mazal-col__group-title::after {
    content: '\2212';
  }

  .mazal-col__options {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-block-end: 20px;
  }

  .mazal-col__check {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    line-height: 1.45;
    cursor: pointer;
  }

  .mazal-col__check.is-disabled {
    color: var(--mazal-grey);
    cursor: default;
  }

  .mazal-col__check input {
    position: absolute;
    opacity: 0;
    width: 16px;
    height: 16px;
    margin: 0;
  }

  .mazal-col__box {
    display: block;
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    border: 1px solid var(--mazal-grey);
    border-radius: 4px;
    background-position: center;
    background-size: cover;
  }

  .mazal-col__box--round {
    border-radius: 50%;
  }

  .mazal-col__check input:checked + .mazal-col__box {
    border-color: #000;
    box-shadow: inset 0 0 0 3px #fff;
    background-color: #000;
  }

  .mazal-col__check input:checked + .mazal-col__box--swatch {
    box-shadow: 0 0 0 1px #fff, 0 0 0 2px #000;
  }

  .mazal-col__check input:focus-visible + .mazal-col__box {
    outline: 2px solid var(--mazal-gold);
    outline-offset: 2px;
  }

  .mazal-col__option-count {
    color: var(--mazal-grey);
  }

  .mazal-col__price-range {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    padding-block-end: 20px;
  }

  .mazal-col__price-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 12px;
    text-transform: uppercase;
  }

  .mazal-col__price-field input {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--mazal-grey);
    border-radius: 0;
    background: #fff;
    font-family: inherit;
    font-size: 14px;
  }

  .mazal-col__drawer-foot {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    padding: 20px 32px;
    border-block-start: 1px solid #f7f7f7;
  }

  .mazal-col__clear,
  .mazal-col__apply {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px 16px;
    font-family: var(--font-body--family);
    font-size: 14px;
    line-height: 1.45;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
  }

  .mazal-col__clear {
    border: 1px solid #000;
    color: #000;
  }

  .mazal-col__apply {
    border: 0;
    background: var(--mazal-gold);
    color: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .mazal-col__add,
    .mazal-col__progress-bar {
      transition: none;
    }

    .mazal-col__drawer[open],
    .mazal-col__count.is-loading .mazal-col__more-link {
      animation: none;
    }
  }

  /* Phones (Figma 6:2514) */
  @media screen and (max-width: 749px) {
    .mazal-col {
      padding: 32px 16px;
    }

    .mazal-col__header {
      margin-block-end: 32px;
    }

    .mazal-col__title {
      font-size: 24px;
    }

    .mazal-col__subtitle {
      font-size: 10px;
    }

    .mazal-col__bar {
      gap: 12px;
      padding-block-end: 0;
      border-block-end: 0;
    }

    .mazal-col__cats {
      gap: 16px;
    }

    .mazal-col__cat {
      font-size: 10px;
    }

    .mazal-col__filters-btn {
      gap: 4px;
      padding: 5px 8px;
      background: var(--mazal-gold);
      color: #fff;
      font-size: 10px;
    }

    .mazal-col__plus {
      width: 14px;
      height: 14px;
    }

    .mazal-col__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .mazal-col__item {
      gap: 8px;
    }

    .mazal-col__media {
      aspect-ratio: 191 / 224;
      padding: 4px;
    }

    .mazal-col__media-link {
      inset: 4px;
    }

    .mazal-col__badge {
      inset-block-start: 8px;
      inset-inline-start: 8px;
      padding: 6.5px 8px;
      font-size: 10px;
    }

    .mazal-col__add {
      inset-inline: auto 12px;
      inset-block-end: 12px;
      width: 24px;
      height: 24px;
      padding: 0;
      transform: none;
    }

    .mazal-col__add-text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .mazal-col__name-row {
      flex-direction: column;
      gap: 8px;
      font-size: 10px;
    }

    .mazal-col__more {
      font-size: 10px;
    }

    .mazal-col__count {
      gap: 16px;
      max-width: none;
      font-size: 10px;
    }

    .mazal-col__drawer-head,
    .mazal-col__drawer-foot {
      padding-inline: 16px;
    }

    .mazal-col__drawer-body {
      padding-inline: 16px;
    }
  }
{% endstylesheet %}

{% javascript %}
  class MazalCollection extends HTMLElement {
    connectedCallback() {
      this.controller = new AbortController();
      const { signal } = this.controller;

      this.drawer = this.querySelector('[data-filters]');
      this.querySelector('[data-filters-open]')?.addEventListener('click', () => this.drawer?.showModal(), { signal });
      this.querySelector('[data-filters-close]')?.addEventListener('click', () => this.drawer?.close(), { signal });
      this.drawer?.addEventListener(
        'click',
        (event) => {
          if (event.target === this.drawer) this.drawer.close();
        },
        { signal }
      );

      this.addEventListener('submit', (event) => this.onSubmit(event), { signal });
      this.setupInfiniteLoad();
    }

    disconnectedCallback() {
      this.controller?.abort();
      this.observer?.disconnect();
    }

    /* Loads the next page when the count / progress bar comes into view. The link stays as a fallback. */
    setupInfiniteLoad() {
      const count = this.querySelector('[data-count]');
      if (!count || !count.dataset.nextUrl) return;
      this.querySelector('[data-more]')?.addEventListener(
        'click',
        (event) => {
          event.preventDefault();
          this.loadMore();
        },
        { signal: this.controller.signal }
      );
      if (!('IntersectionObserver' in window)) return;
      this.observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) this.loadMore();
        },
        { rootMargin: '0px 0px 400px 0px' }
      );
      this.observer.observe(count);
    }

    async loadMore() {
      const count = this.querySelector('[data-count]');
      const nextUrl = count?.dataset.nextUrl;
      if (!nextUrl || this.loading) return;
      this.loading = true;
      count.classList.add('is-loading');
      try {
        const url = new URL(nextUrl, window.location.origin);
        url.searchParams.set('section_id', this.dataset.sectionId);
        const response = await fetch(url, { signal: this.controller.signal });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const html = new DOMParser().parseFromString(await response.text(), 'text/html');
        const items = html.querySelectorAll('[data-grid] > li');
        this.querySelector('[data-grid]')?.append(...items);

        const nextCount = html.querySelector('[data-count]');
        const shown = this.querySelectorAll('[data-grid] > li').length;
        const total = Number(count.dataset.total) || shown;
        const shownLabel = count.querySelector('[data-shown]');
        if (shownLabel) shownLabel.textContent = String(shown);
        const bar = count.querySelector('[data-progress]');
        if (bar) bar.style.width = `${Math.min(100, (shown / total) * 100)}%`;

        const next = nextCount?.dataset.nextUrl;
        if (next) {
          count.dataset.nextUrl = next;
          const link = count.querySelector('[data-more]');
          if (link) link.href = next;
        } else {
          delete count.dataset.nextUrl;
          count.querySelector('[data-more]')?.remove();
          this.observer?.disconnect();
        }
      } catch (error) {
        if (error.name !== 'AbortError') {
          console.error(error);
          window.location.href = nextUrl;
        }
      } finally {
        this.loading = false;
        count.classList.remove('is-loading');
        /* Still in view (short pages): keep going. */
        const rect = count.getBoundingClientRect();
        if (count.dataset.nextUrl && rect.top < window.innerHeight + 400) this.loadMore();
      }
    }

    async onSubmit(event) {
      const form = event.target;
      if (!(form instanceof HTMLFormElement) || !form.hasAttribute('data-col-add')) return;
      event.preventDefault();
      const button = form.querySelector('button');
      button?.setAttribute('aria-busy', 'true');
      try {
        const { CartLinesUpdateEvent } = await import('@shopify/events');
        const formData = new FormData(form);
        const sectionIds = Array.from(document.querySelectorAll('cart-items-component'))
          .map((element) => element.dataset.sectionId)
          .filter(Boolean);
        if (sectionIds.length) formData.append('sections', sectionIds.join(','));

        const deferred = CartLinesUpdateEvent.createPromise();
        this.dispatchEvent(
          new CartLinesUpdateEvent({
            action: 'add',
            context: 'product',
            lines: [{ merchandiseId: String(formData.get('id')), quantity: 1 }],
            promise: deferred.promise,
          })
        );

        const addUrl = (window.Theme && window.Theme.routes && window.Theme.routes.cart_add_url) || form.action;
        const response = await fetch(addUrl, {
          method: 'POST',
          headers: { Accept: 'application/javascript', 'X-Requested-With': 'XMLHttpRequest' },
          body: formData,
        }).then((result) => result.json());

        const cartItems = document.querySelector('cart-items-component');
        let cart;
        if (cartItems && typeof cartItems.fetchCartData === 'function') {
          await customElements.whenDefined('cart-items-component');
          cart = await cartItems.fetchCartData();
        } else {
          cart = await fetch('/cart.js', { headers: { Accept: 'application/json' } }).then((result) => result.json());
        }

        deferred.resolve({
          cart: CartLinesUpdateEvent.createCartFromAjaxResponse(cart),
          detail: {
            items: cart.items,
            source: 'mazal-collection',
            sourceId: this.id,
            itemCount: 1,
            sections: response.sections,
            didError: Boolean(response.status),
          },
        });
      } catch (error) {
        console.error(error);
        form.submit();
      } finally {
        button?.removeAttribute('aria-busy');
      }
    }
  }

  if (!customElements.get('mazal-collection')) {
    customElements.define('mazal-collection', MazalCollection);
  }
{% endjavascript %}

{% schema %}
{
  "name": "Mazal shop",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    { "type": "text", "id": "all_title", "label": "Title on the all products page", "default": "All Products", "info": "Other collections show their own title." },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Timeless designs of uncompromising quality, made for home comfort", "info": "Used when the collection has no description." },
    { "type": "text", "id": "categories_label", "label": "Categories label (screen readers)", "default": "Categories" },
    { "type": "header", "content": "Filters" },
    { "type": "checkbox", "id": "enable_filters", "label": "Show filters", "default": true, "info": "Choose filters in the Search & Discovery app." },
    { "type": "checkbox", "id": "enable_sorting", "label": "Show sorting in filters", "default": true },
    { "type": "text", "id": "filters_label", "label": "Filters button", "default": "FILTERS" },
    { "type": "text", "id": "sort_label", "label": "Sort title", "default": "Sort by" },
    { "type": "text", "id": "from_label", "label": "Price from", "default": "From" },
    { "type": "text", "id": "to_label", "label": "Price to", "default": "To" },
    { "type": "text", "id": "clear_label", "label": "Clear button", "default": "Clear all" },
    { "type": "text", "id": "apply_label", "label": "Apply button", "default": "Apply" },
    { "type": "header", "content": "Products" },
    { "type": "range", "id": "per_page", "label": "Products per load", "min": 8, "max": 48, "step": 4, "default": 16 },
    { "type": "text", "id": "count_text", "label": "Count text", "default": "SHOWING [shown] OF [total] PRODUCTS", "info": "[shown] is the number on the page, [total] is the total." },
    { "type": "text", "id": "loading_text", "label": "Loading text", "default": "LOADING MORE PRODUCTS..." },
    { "type": "text", "id": "empty_text", "label": "No products text", "default": "No products found." },
    { "type": "header", "content": "Card" },
    { "type": "text", "id": "badge_text", "label": "Image label", "default": "NEW ARRIVAL", "info": "Leave empty to hide." },
    { "type": "text", "id": "badge_tag", "label": "Show the label only on products tagged", "info": "Empty shows it on every product." },
    { "type": "text", "id": "add_label", "label": "Add to cart text", "default": "ADD TO CART" },
    { "type": "text", "id": "color_option_name", "label": "Color option name", "default": "Color" },
    { "type": "text", "id": "more_label", "label": "More colors text", "default": "[count]+ More", "info": "[count] is replaced by the colors not shown." },
    { "type": "textarea", "id": "swatch_colors", "label": "Swatch colors", "default": "Pink: #f6c9d1\nGrey: #dbdada\nPeach: #f6ddc9\nMint: #c9f6e0", "info": "One per line as Name: #hex." }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label", "info": "Empty uses the collection title." }
      ]
    }
  ],
  "presets": [
    { "name": "Mazal shop" }
  ]
}
{% endschema %}
