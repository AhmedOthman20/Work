{%- comment -%}
  Section contract.
  Mazal shop / collection page (Figma: Shop 1:1312 desktop, 6:2514 mobile).
  Title + subtitle, category links (blocks) with a FILTERS button that opens the sorting and Shopify
  filters (inline panel on desktop, popup on phones), a 4-column (2 on phones) grid of product cards, then "Showing X of N products"
  with a progress bar. The next page loads by itself when the bar scrolls into view.
  @example
  <!-- templates/collection.json -->
{%- endcomment -%}
{%- liquid
  assign color_keyword = section.settings.color_option_name | downcase | strip
  if collection.handle == 'all' and section.settings.all_title != blank
    assign page_title = section.settings.all_title
  else
    assign page_title = collection.title
  endif
  assign page_subtitle = collection.description | strip_html | strip
  if page_subtitle == blank
    assign page_subtitle = section.settings.subtitle
  endif
  assign active_filter_count = 0
  for filter in collection.filters
    assign active_filter_count = active_filter_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != null or filter.max_value.value != null
        assign active_filter_count = active_filter_count | plus: 1
      endif
    endif
  endfor
  assign sort_by = collection.sort_by | default: collection.default_sort_by
-%}

<div class="section-background"></div>
<mazal-collection class="mazal-col" data-section-id="{{ section.id }}">
  <div class="mazal-col__header">
    <h1 class="mazal-col__title">{{ page_title | escape }}</h1>
    {%- if page_subtitle != blank -%}
      <p class="mazal-col__subtitle">{{ page_subtitle | escape }}</p>
    {%- endif -%}
  </div>

  <div class="mazal-col__top">
  <div class="mazal-col__bar">
    <nav class="mazal-col__cats" aria-label="{{ section.settings.categories_label | escape }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign cat = block.settings.collection
          assign cat_label = block.settings.label | default: cat.title
          assign cat_url = cat.url | default: routes.all_products_collection_url
          assign is_active = false
          if cat and cat.handle == collection.handle
            assign is_active = true
          endif
        -%}
        <a
          class="mazal-col__cat{% if is_active %} is-active{% endif %}"
          href="{{ cat_url }}"
          {% if is_active %}aria-current="page"{% endif %}
          {{ block.shopify_attributes }}
        >
          {{- cat_label | escape -}}
        </a>
      {%- endfor -%}
    </nav>

    {%- if section.settings.enable_filters -%}
      <button
        type="button"
        class="mazal-col__filters-btn"
        aria-expanded="false"
        aria-controls="MazalFilters-{{ section.id }}"
        data-filters-toggle
      >
        <svg class="mazal-col__plus" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 19.5V4.5M4.5 12h15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <svg class="mazal-col__x" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6.5 6.5l11 11M17.5 6.5l-11 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <span>{{ section.settings.filters_label | escape }}{% if active_filter_count > 0 %} ({{ active_filter_count }}){% endif %}</span>
      </button>
    {%- endif -%}
  </div>

    {%- if section.settings.enable_filters -%}
      <div class="mazal-col__panel" id="MazalFilters-{{ section.id }}" data-filters>
        <div class="mazal-col__panel-clip">
          <form
            class="mazal-col__panel-box"
            action="{{ collection.url }}"
            method="get"
            aria-label="{{ section.settings.filters_label | escape }}"
          >
            <div class="mazal-col__panel-head">
              <p class="mazal-col__panel-title">{{ section.settings.filters_label | escape }}</p>
              <button type="button" class="mazal-col__close" data-filters-close>
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                <span>{{ section.settings.close_label | escape }}</span>
              </button>
            </div>

            <div class="mazal-col__search">
              <input
                type="search"
                placeholder="{{ section.settings.search_placeholder | escape }}"
                aria-label="{{ section.settings.search_placeholder | escape }}"
                data-filter-search
              >
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.5"/>
                <path d="M16 16l4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </div>

            <div class="mazal-col__groups">
              {%- if section.settings.enable_sorting -%}
                <div class="mazal-col__group mazal-col__group--sort" role="group" aria-labelledby="MazalSort-{{ section.id }}" data-filter-group>
                  <p class="mazal-col__group-title" id="MazalSort-{{ section.id }}">{{ section.settings.sort_label | escape }}</p>
                  <div class="mazal-col__options">
                    {%- for option in collection.sort_options -%}
                      <label class="mazal-col__check" data-filter-option>
                        <input type="radio" name="sort_by" value="{{ option.value | escape }}" {% if option.value == sort_by %}checked{% endif %}>
                        <span class="mazal-col__box" aria-hidden="true"></span>
                        <span class="mazal-col__label">{{ option.name | escape }}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}

              {%- for filter in collection.filters -%}
                {%- liquid
                  assign filter_key = filter.label | downcase
                  assign group_class = ''
                  if filter_key contains 'color' or filter_key contains 'colour'
                    assign group_class = ' mazal-col__group--color'
                  endif
                -%}
                {%- if filter.type == 'price_range' -%}
                  {%- liquid
                    assign range_max = filter.range_max | money_without_currency | remove: ',' | ceil
                    assign current_min = 0
                    assign current_max = range_max
                    if filter.min_value.value != null
                      assign current_min = filter.min_value.value | money_without_currency | remove: ',' | floor
                    endif
                    if filter.max_value.value != null
                      assign current_max = filter.max_value.value | money_without_currency | remove: ',' | ceil
                    endif
                  -%}
                  <div class="mazal-col__group mazal-col__group--price" role="group" aria-labelledby="MazalFilter-{{ section.id }}-{{ forloop.index }}">
                    <p class="mazal-col__group-title" id="MazalFilter-{{ section.id }}-{{ forloop.index }}">{{ section.settings.price_label | default: filter.label | escape }}</p>
                    <div class="mazal-col__range" data-range data-max="{{ range_max }}" data-currency="{{ cart.currency.iso_code }}">
                      <div class="mazal-col__range-slider">
                        <span class="mazal-col__range-track" aria-hidden="true"><span class="mazal-col__range-fill" data-range-fill></span></span>
                        <input type="range" min="0" max="{{ range_max }}" step="1" value="{{ current_min }}" aria-label="{{ section.settings.from_label | escape }}" data-range-min>
                        <input type="range" min="0" max="{{ range_max }}" step="1" value="{{ current_max }}" aria-label="{{ section.settings.to_label | escape }}" data-range-max>
                      </div>
                      <div class="mazal-col__range-values">
                        <span class="mazal-col__range-value" data-range-min-label>{{ cart.currency.iso_code }} {{ current_min }}</span>
                        <span class="mazal-col__range-sep" aria-hidden="true"></span>
                        <span class="mazal-col__range-value" data-range-max-label>{{ cart.currency.iso_code }} {{ current_max }}</span>
                      </div>
                      <input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ current_min }}" data-range-min-input {% if filter.min_value.value == null %}disabled{% endif %}>
                      <input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ current_max }}" data-range-max-input {% if filter.max_value.value == null %}disabled{% endif %}>
                    </div>
                  </div>
                {%- else -%}
                  <div class="mazal-col__group{{ group_class }}" role="group" aria-labelledby="MazalFilter-{{ section.id }}-{{ forloop.index }}" data-filter-group>
                    <p class="mazal-col__group-title" id="MazalFilter-{{ section.id }}-{{ forloop.index }}">{{ filter.label | escape }}</p>
                    <div class="mazal-col__options">
                      {%- for value in filter.values -%}
                        <label class="mazal-col__check{% if value.count == 0 and value.active == false %} is-disabled{% endif %}" data-filter-option>
                          <input
                            type="checkbox"
                            name="{{ value.param_name }}"
                            value="{{ value.value | escape }}"
                            {% if value.active %}checked{% endif %}
                            {% if value.count == 0 and value.active == false %}disabled{% endif %}
                          >
                          <span class="mazal-col__box" aria-hidden="true"></span>
                          <span class="mazal-col__label">{{ value.label | escape }}</span>
                        </label>
                      {%- endfor -%}
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>

            <div class="mazal-col__actions">
              <button type="submit" class="mazal-col__apply">{{ section.settings.apply_label | escape }}</button>
              <a class="mazal-col__clear" href="{{ collection.url }}?sort_by={{ sort_by }}">{{ section.settings.clear_label | escape }}</a>
            </div>
          </form>
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- paginate collection.products by section.settings.per_page -%}
    {%- liquid
      assign shown_count = paginate.current_offset | plus: collection.products.size
      assign total_count = collection.products_count
      if total_count > 0
        assign progress = shown_count | times: 100.0 | divided_by: total_count
      else
        assign progress = 0
      endif
    -%}

    {%- if collection.products.size == 0 -%}
      <div class="mazal-col__empty">
        <p>{{ section.settings.empty_text | escape }}</p>
        {%- if active_filter_count > 0 -%}
          <a href="{{ collection.url }}?sort_by={{ sort_by }}">{{ section.settings.clear_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="mazal-col__grid" role="list" data-grid>
      {%- for item in collection.products -%}
        {%- liquid
          assign item_variant = item.selected_or_first_available_variant
          assign color_option = null
          for option in item.options_with_values
            assign option_key = option.name | downcase | strip
            if option_key == color_keyword or option_key == 'color' or option_key == 'colour'
              assign color_option = option
              break
            endif
          endfor
          assign show_badge = false
          if section.settings.badge_text != blank
            if section.settings.badge_tag == blank or item.tags contains section.settings.badge_tag
              assign show_badge = true
            endif
          endif
          assign image_loading = 'lazy'
          if paginate.current_page == 1 and forloop.index <= 4
            assign image_loading = 'eager'
          endif
        -%}
        <li class="mazal-col__item">
          <div class="mazal-col__media">
            <a class="mazal-col__media-link" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
              {%- if item.featured_image -%}
                {{
                  item.featured_image
                  | image_url: width: 900
                  | image_tag:
                    widths: '200, 380, 500, 660, 900',
                    sizes: '(min-width: 750px) calc((100vw - 200px) / 4), calc((100vw - 48px) / 2)',
                    loading: image_loading,
                    alt: item.title,
                    class: 'mazal-col__image'
                }}
              {%- else -%}
                {{ 'product-apparel-1' | placeholder_svg_tag: 'mazal-col__image' }}
              {%- endif -%}
            </a>
            {%- if show_badge -%}
              <span class="mazal-col__badge">{{ section.settings.badge_text | escape }}</span>
            {%- endif -%}
            {%- if item.has_only_default_variant and item_variant.available -%}
              {%- form 'product', item, class: 'mazal-col__add-form', data-col-add: '' -%}
                <input type="hidden" name="id" value="{{ item_variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="mazal-col__add" aria-label="{{ section.settings.add_label | escape }}: {{ item.title | escape }}">
                  <span class="mazal-col__add-icon" aria-hidden="true">{{ 'mazal-icon-bag-white.svg' | inline_asset_content }}</span>
                  <span class="mazal-col__add-text">{{ section.settings.add_label | escape }}</span>
                </button>
              {%- endform -%}
            {%- else -%}
              <a class="mazal-col__add" href="{{ item.url }}" aria-label="{{ section.settings.add_label | escape }}: {{ item.title | escape }}">
                <span class="mazal-col__add-icon" aria-hidden="true">{{ 'mazal-icon-bag-white.svg' | inline_asset_content }}</span>
                <span class="mazal-col__add-text">{{ section.settings.add_label | escape }}</span>
              </a>
            {%- endif -%}
          </div>

          <div class="mazal-col__info">
            <a class="mazal-col__name-row" href="{{ item.url }}">
              <span class="mazal-col__name">{{ item.title | escape }}</span>
              <span class="mazal-col__price">{{ item_variant.price | money }}</span>
            </a>
            {%- if color_option and color_option.values.size > 1 -%}
              <div class="mazal-col__colors">
                <span class="mazal-col__dots">
                  {%- for value in color_option.values limit: 3 -%}
                    {%- render 'mazal-swatch', value: value, colors: section.settings.swatch_colors, class: 'mazal-col__dot' -%}
                  {%- endfor -%}
                </span>
                {%- assign more = color_option.values.size | minus: 3 -%}
                {%- if more > 0 and section.settings.more_label != blank -%}
                  <span class="mazal-col__more">{{ section.settings.more_label | replace: '[count]', more }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>

    {%- if total_count > 0 -%}
      <div
        class="mazal-col__count"
        data-count
        data-total="{{ total_count }}"
        {% if paginate.next %}data-next-url="{{ paginate.next.url }}"{% endif %}
      >
        <p class="mazal-col__count-text">
          {%- capture shown_html -%}<span data-shown>{{ shown_count }}</span>{%- endcapture -%}
          {{- section.settings.count_text | escape | replace: '[shown]', shown_html | replace: '[total]', total_count -}}
        </p>
        <div class="mazal-col__progress" aria-hidden="true">
          <span class="mazal-col__progress-bar" style="width: {{ progress }}%;" data-progress></span>
        </div>
        {%- if paginate.next -%}
          <a class="mazal-col__more-link" href="{{ paginate.next.url }}" data-more>{{ section.settings.loading_text | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endpaginate -%}

</mazal-collection>

{% stylesheet %}
  .mazal-col {
    --mazal-gold: #bb955a;
    --mazal-grey: #a1a1a1;
    display: flex;
    flex-direction: column;
    padding: 64px;
    color: #000;
    font-family: var(--font-body--family);
  }

  /* Title + subtitle (Figma 1:1313) */
  .mazal-col__header {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-block-end: 64px;
  }

  .mazal-col__title {
    margin: 0;
    color: #000;
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 48px;
    line-height: 1.21;
    letter-spacing: normal;
    text-transform: uppercase;
  }

  .mazal-col__subtitle {
    margin: 0;
    font-size: 14px;
    line-height: 1.45;
  }

  /* Categories + filters (Figma 1:1317), then a grey rule */
  .mazal-col__top {
    padding-block-end: 32px;
    margin-block-end: 32px;
    border-block-end: 1px solid var(--mazal-grey);
  }

  .mazal-col__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .mazal-col__cats {
    display: flex;
    align-items: center;
    gap: 20px;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .mazal-col__cats::-webkit-scrollbar {
    display: none;
  }

  .mazal-col__cat {
    flex-shrink: 0;
    color: var(--mazal-grey);
    font-size: 16px;
    line-height: 1.45;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .mazal-col__cat:hover {
    color: #000;
  }

  .mazal-col__cat.is-active {
    color: #000;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  .mazal-col__filters-btn {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 8px;
    padding: 0;
    border: 0;
    background: none;
    color: #000;
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: 16px;
    line-height: 1.45;
    text-transform: uppercase;
    cursor: pointer;
  }

  .mazal-col__plus,
  .mazal-col__x {
    display: block;
    width: 24px;
    height: 24px;
  }

  .mazal-col__x,
  .mazal-col.is-filters-open .mazal-col__plus {
    display: none;
  }

  .mazal-col.is-filters-open .mazal-col__x {
    display: block;
  }

  /* Product grid (Figma 1:1319): 4 x 328px cards, 24px columns, 32px rows */
  .mazal-col__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mazal-col__item {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  .mazal-col__media {
    position: relative;
    aspect-ratio: 328 / 424;
    padding: 8px;
    overflow: hidden;
    background: #f7f7f7;
  }

  .mazal-col__media-link {
    position: absolute;
    inset: 8px;
    display: block;
  }

  .mazal-col__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mazal-col__badge {
    position: absolute;
    inset-block-start: 16px;
    inset-inline-start: 16px;
    padding: 8px 16px;
    background: #fff;
    color: #000;
    font-size: 12px;
    line-height: 1;
    text-transform: uppercase;
    pointer-events: none;
  }

  .mazal-col__add-form {
    display: contents;
  }

  /* Add to cart bar sits just below the image and slides up on hover (Figma: top 434 of 424). */
  .mazal-col__add {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 7.5px 16px;
    border: 0;
    background: var(--mazal-gold);
    color: #fff;
    font-family: var(--font-body--family);
    font-size: 12px;
    line-height: 1.45;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
    transform: translateY(100%);
    transition: transform 0.3s ease;
  }

  .mazal-col__media:hover .mazal-col__add,
  .mazal-col__add:focus-visible {
    transform: translateY(0);
  }

  .mazal-col__add[aria-busy='true'] {
    opacity: 0.7;
    pointer-events: none;
  }

  .mazal-col__add-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
  }

  .mazal-col__info {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .mazal-col__name-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    color: #000;
    font-weight: 500;
    font-size: 14px;
    line-height: 1.45;
    text-decoration: none;
    text-transform: uppercase;
  }

  .mazal-col__price {
    flex-shrink: 0;
  }

  .mazal-col__colors {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .mazal-col__dots {
    display: flex;
    gap: 4px;
  }

  .mazal-col__dot {
    display: block;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background-position: center;
    background-size: cover;
    box-shadow: inset 0 0 0 0.5px rgb(0 0 0 / 0.1);
  }

  .mazal-col__more {
    font-size: 12px;
    line-height: 1.2;
  }

  .mazal-col__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding-block: 64px;
    font-size: 14px;
    text-align: center;
  }

  .mazal-col__empty p {
    margin: 0;
  }

  .mazal-col__empty a {
    color: #000;
    text-transform: uppercase;
  }

  /* Products count + progress (Figma 1:1340) */
  .mazal-col__count {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    width: 100%;
    max-width: 624px;
    margin: 32px auto 0;
    font-size: 14px;
    line-height: 1.45;
    text-align: center;
    text-transform: uppercase;
  }

  .mazal-col__count-text {
    margin: 0;
  }

  .mazal-col__progress {
    position: relative;
    width: 100%;
    height: 2px;
    overflow: hidden;
    background: #f7f7f7;
  }

  .mazal-col__progress-bar {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    background: #000;
    transition: width 0.4s ease;
  }

  .mazal-col__more-link {
    color: #000;
    text-decoration: none;
  }

  .mazal-col__count.is-loading .mazal-col__more-link {
    animation: mazal-col-pulse 1.2s ease-in-out infinite;
  }

  @keyframes mazal-col-pulse {
    50% {
      opacity: 0.4;
    }
  }

  /* Filters panel: opens under the bar on desktop (screenshot "filters open"), a popup on phones. */
  .mazal-col__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s ease;
  }

  .mazal-col.is-filters-open .mazal-col__panel {
    grid-template-rows: 1fr;
  }

  .mazal-col__panel-clip {
    min-height: 0;
    overflow: hidden;
    visibility: hidden;
    transition: visibility 0s linear 0.35s;
  }

  .mazal-col.is-filters-open .mazal-col__panel-clip {
    visibility: visible;
    transition: none;
  }

  .mazal-col__panel-box {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-block-start: 40px;
  }

