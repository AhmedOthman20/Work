{%- comment -%}
  Section contract.
  Mazal Contact page (Figma: Contact Us 1:1774 desktop, 6:3130 mobile).
  Hero image with a centered title, then "Got a question?" with working hours, phone / WhatsApp and
  email on the left and the contact form on the right. On phones the form comes before the details,
  which are centered.
  @example
  <!-- templates/page.contact.json -->
{%- endcomment -%}
{%- liquid
  assign phone_digits = section.settings.phone_link | remove: ' ' | remove: '+' | remove: '(' | remove: ')' | remove: '-'
  assign whatsapp_digits = section.settings.whatsapp | remove: ' ' | remove: '+' | remove: '(' | remove: ')' | remove: '-'
  assign inquiry_types = section.settings.inquiry_types | newline_to_br | split: '<br />'
-%}
<div class="section-background"></div>
<div class="mazal-ct">
  <div class="mazal-ct__hero">
    {%- if section.settings.image -%}
      {{
        section.settings.image
        | image_url: width: 3000
        | image_tag:
          widths: '430, 750, 1100, 1500, 2000, 3000',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          class: 'mazal-ct__hero-image'
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'mazal-ct__hero-image' }}
    {%- endif -%}
    {%- if section.settings.hero_title != blank -%}
      <h1 class="mazal-ct__hero-title">{{ section.settings.hero_title }}</h1>
    {%- endif -%}
  </div>

  <div class="mazal-ct__body">
    <div class="mazal-ct__info">
      <div class="mazal-ct__intro">
        {%- if section.settings.title != blank -%}
          <h2 class="mazal-ct__title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="mazal-ct__text">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>

      <div class="mazal-ct__details">
        {%- if section.settings.hours_title != blank or section.settings.hours != blank -%}
          <div class="mazal-ct__hours">
            <p class="mazal-ct__hours-title">{{ section.settings.hours_title }}</p>
            <p class="mazal-ct__hours-text">{{ section.settings.hours }}</p>
          </div>
        {%- endif -%}
        <div class="mazal-ct__contacts">
          {%- if section.settings.phone != blank -%}
            <p class="mazal-ct__contact">
              <span class="mazal-ct__icon" aria-hidden="true">{{ 'mazal-icon-call.svg' | inline_asset_content }}</span>
              <a class="mazal-ct__link" href="tel:+{{ phone_digits }}">{{ section.settings.phone }}</a>
              {%- if whatsapp_digits != blank and section.settings.whatsapp_label != blank -%}
                <span class="mazal-ct__sep" aria-hidden="true">|</span>
                <a class="mazal-ct__text-us" href="https://wa.me/{{ whatsapp_digits }}" target="_blank" rel="noopener">
                  {{- section.settings.whatsapp_label -}}
                </a>
              {%- endif -%}
            </p>
          {%- endif -%}
          {%- if section.settings.email != blank -%}
            <p class="mazal-ct__contact">
              <span class="mazal-ct__icon mazal-ct__icon--mail" aria-hidden="true">{{ 'mazal-icon-mail.svg' | inline_asset_content }}</span>
              <a class="mazal-ct__link" href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
            </p>
          {%- endif -%}
        </div>
      </div>
    </div>

    {%- form 'contact', id: 'MazalContactForm', class: 'mazal-ct__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="mazal-ct__notice" role="status">{{ 'blocks.contact_form.post_success' | t }}</p>
      {%- elsif form.errors -%}
        <div class="mazal-ct__notice mazal-ct__notice--error" role="alert">
          <p>{{ 'blocks.contact_form.error_heading' | t }}</p>
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="mazal-ct__fields">
        <div class="mazal-ct__field">
          <label class="mazal-ct__label" for="MazalContact-name">{{ section.settings.name_label }}</label>
          <input
            class="mazal-ct__input"
            id="MazalContact-name"
            type="text"
            name="contact[name]"
            autocomplete="name"
            placeholder="{{ section.settings.name_placeholder | escape }}"
            value="{{ form.name }}"
          >
        </div>
        <div class="mazal-ct__field">
          <label class="mazal-ct__label" for="MazalContact-email">{{ section.settings.email_label }}</label>
          <input
            class="mazal-ct__input"
            id="MazalContact-email"
            type="email"
            name="contact[email]"
            autocomplete="email"
            autocapitalize="off"
            spellcheck="false"
            required
            placeholder="{{ section.settings.email_placeholder | escape }}"
            value="{{ form.email }}"
          >
        </div>
        <div class="mazal-ct__field">
          <label class="mazal-ct__label" for="MazalContact-type">{{ section.settings.type_label }}</label>
          <div class="mazal-ct__select-wrap">
            <select class="mazal-ct__input mazal-ct__select" id="MazalContact-type" name="contact[{{ section.settings.type_label | escape }}]">
              <option value="" selected disabled>{{ section.settings.type_placeholder }}</option>
              {%- for type in inquiry_types -%}
                {%- assign type_name = type | strip -%}
                {%- if type_name != blank -%}
                  <option value="{{ type_name | escape }}">{{ type_name }}</option>
                {%- endif -%}
              {%- endfor -%}
            </select>
            <span class="mazal-ct__chevron" aria-hidden="true">{{ 'mazal-icon-chevron-down.svg' | inline_asset_content }}</span>
          </div>
        </div>
        <div class="mazal-ct__field">
          <label class="mazal-ct__label" for="MazalContact-body">{{ section.settings.message_label }}</label>
          <textarea
            class="mazal-ct__input mazal-ct__textarea"
            id="MazalContact-body"
            name="contact[body]"
            required
            placeholder="{{ section.settings.message_placeholder | escape }}"
          >{{ form.body }}</textarea>
        </div>
      </div>
      <button type="submit" class="mazal-ct__submit">{{ section.settings.submit_label }}</button>
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
  .mazal-ct {
    --mazal-gold: #bb955a;
    color: #000;
    font-family: var(--font-body--family);
  }

  .mazal-ct__hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 624px;
    overflow: hidden;
  }

  .mazal-ct__hero-image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mazal-ct__hero-title {
    position: relative;
    margin: 0;
    padding-inline: 16px;
    color: #fff;
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 48px;
    line-height: 1.21;
    letter-spacing: normal;
    text-align: center;
    text-transform: uppercase;
  }

  .mazal-ct__body {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    align-items: start;
    padding: 64px;
  }

  .mazal-ct__info {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .mazal-ct__intro {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .mazal-ct__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 48px;
    line-height: 1.21;
    letter-spacing: normal;
    text-transform: uppercase;
  }

  .mazal-ct__text,
  .mazal-ct__hours-text {
    margin: 0;
    font-size: 14px;
    line-height: 1.45;
  }

  .mazal-ct__details {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .mazal-ct__hours {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .mazal-ct__hours-title {
    margin: 0;
    font-size: 16px;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .mazal-ct__contacts {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .mazal-ct__contact {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 0;
    font-size: 14px;
    line-height: 1.45;
  }

  .mazal-ct__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
  }

  .mazal-ct__icon--mail {
    width: 20px;
    height: 20px;
  }

  .mazal-ct__link {
    color: var(--mazal-gold);
    text-decoration: none;
  }

  .mazal-ct__sep {
    font-size: 12px;
  }

  .mazal-ct__text-us {
    color: #000;
    text-decoration: none;
  }

  .mazal-ct__link:hover,
  .mazal-ct__text-us:hover {
    text-decoration: underline;
  }

  .mazal-ct__form {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 32px;
    min-width: 0;
  }

  .mazal-ct__fields {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .mazal-ct__field {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .mazal-ct__label {
    font-size: 14px;
    line-height: 1.45;
  }

  .mazal-ct .mazal-ct__form .mazal-ct__input {
    display: block;
    box-sizing: border-box;
    width: 100%;
    max-width: none;
    margin: 0;
    box-shadow: none;
    min-height: 44px;
    padding: 12px 16px;
    border: 1px solid transparent;
    border-radius: 0;
    background: #f7f7f7;
    color: #000;
    font-family: inherit;
    font-size: 14px;
    line-height: 1.45;
    outline: none;
  }

  .mazal-ct .mazal-ct__form .mazal-ct__input::placeholder {
    color: #a1a1a1;
    opacity: 1;
  }

  .mazal-ct .mazal-ct__form .mazal-ct__input:focus-visible {
    border-color: var(--mazal-gold);
  }

  .mazal-ct__select-wrap {
    position: relative;
  }

  .mazal-ct .mazal-ct__form .mazal-ct__select {
    padding-inline-end: 48px;
    appearance: none;
    cursor: pointer;
  }

  .mazal-ct__select:invalid,
  .mazal-ct__select:has(option[value='']:checked) {
    color: #a1a1a1;
  }

  .mazal-ct__chevron {
    position: absolute;
    inset-inline-end: 16px;
    top: 50%;
    display: inline-flex;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .mazal-ct .mazal-ct__form .mazal-ct__textarea {
    height: 224px;
    padding-block: 16px;
    resize: vertical;
  }

  .mazal-ct__submit {
    width: 100%;
    min-height: 44px;
    padding: 12px 16px;
    border: 0;
    background: var(--mazal-gold);
    color: #fff;
    font-family: inherit;
    font-size: 14px;
    line-height: 1.45;
    text-transform: uppercase;
    cursor: pointer;
  }

  .mazal-ct__submit:hover {
    opacity: 0.9;
  }

  .mazal-ct__notice {
    margin: 0;
    padding: 12px 16px;
    background: rgb(187 149 90 / 0.1);
    font-size: 14px;
  }

  .mazal-ct__notice p {
    margin: 0;
  }

  .mazal-ct__notice--error {
    background: rgb(200 40 40 / 0.08);
    color: #9b1c1c;
  }

  /* Phones (Figma 6:3130): intro, then the form, then the details centered. */
  @media screen and (max-width: 749px) {
    .mazal-ct__hero {
      height: 424px;
    }

    .mazal-ct__hero-title {
      font-size: 32px;
    }

    .mazal-ct__body {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 32px;
      padding: 32px 16px;
    }

    .mazal-ct__info {
      display: contents;
    }

    .mazal-ct__intro {
      order: 1;
      text-align: center;
    }

    .mazal-ct__form {
      order: 2;
    }

    .mazal-ct__details {
      order: 3;
      align-items: center;
      gap: 16px;
      text-align: center;
    }

    .mazal-ct__title {
      font-size: 24px;
    }

    .mazal-ct__text {
      font-size: 10px;
      text-align: center;
    }

    .mazal-ct__hours {
      align-items: center;
    }

    .mazal-ct__hours-title,
    .mazal-ct__hours-text,
    .mazal-ct__contact,
    .mazal-ct__label {
      font-size: 12px;
    }

    .mazal-ct__contacts {
      align-items: center;
      gap: 16px;
    }

    .mazal-ct__contact {
      gap: 8px;
    }

    .mazal-ct__sep {
      font-size: 10px;
    }

    .mazal-ct__form {
      gap: 32px;
    }

    .mazal-ct__field {
      gap: 16px;
    }

    .mazal-ct .mazal-ct__form .mazal-ct__input {
      min-height: 32px;
      padding: 8px 16px;
      font-size: 10px;
    }

    .mazal-ct .mazal-ct__form .mazal-ct__select {
      padding-inline-end: 40px;
    }

    .mazal-ct__chevron svg {
      width: 16px;
      height: 16px;
    }

    .mazal-ct .mazal-ct__form .mazal-ct__textarea {
      height: 94px;
      padding-block: 16px;
    }

    .mazal-ct__submit {
      min-height: 32px;
      padding-block: 8px;
      font-size: 10px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mazal contact",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "hero_title", "label": "Title", "default": "CUSTOMER CARE" },
    { "type": "header", "content": "Details" },
    { "type": "text", "id": "title", "label": "Heading", "default": "GOT A QUESTION?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "We're here to help with anything you need, from product questions to order support. Reach out, and we'll be happy to assist." },
    { "type": "text", "id": "hours_title", "label": "Hours heading", "default": "WORKING HOURS" },
    { "type": "text", "id": "hours", "label": "Hours", "default": "Monday - Friday : 09:00 AM | 03:00 PM" },
    { "type": "text", "id": "phone", "label": "Phone (as shown)", "default": "(+20) 122 191 5572" },
    { "type": "text", "id": "phone_link", "label": "Phone (international, for calling)", "default": "+201221915572" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp number (international)", "default": "+201221915572" },
    { "type": "text", "id": "whatsapp_label", "label": "WhatsApp link text", "default": "Text Us" },
    { "type": "text", "id": "email", "label": "Email", "default": "support@mazalegypt.com" },
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "name_label", "label": "Name label", "default": "Full Name" },
    { "type": "text", "id": "name_placeholder", "label": "Name placeholder", "default": "Enter your full name" },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "Email Address" },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "Your email address" },
    { "type": "text", "id": "type_label", "label": "Inquiry label", "default": "Inquiry Type" },
    { "type": "text", "id": "type_placeholder", "label": "Inquiry placeholder", "default": "How can we help?" },
    { "type": "textarea", "id": "inquiry_types", "label": "Inquiry types", "default": "Order support\nProduct question\nReturns & exchanges\nWholesale\nOther", "info": "One per line." },
    { "type": "text", "id": "message_label", "label": "Message label", "default": "Your Message" },
    { "type": "text", "id": "message_placeholder", "label": "Message placeholder", "default": "Tell us how we can support you..." },
    { "type": "text", "id": "submit_label", "label": "Button text", "default": "SUBMIT" }
  ],
  "presets": [{ "name": "Mazal contact" }]
}
{% endschema %}
