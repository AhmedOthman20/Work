  /* ---------- Related products ---------- */
  .mazal-pdp__related {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .mazal-pdp__related-heading {
    margin: 0;
    font-family: var(--font-body--family);
    font-weight: var(--font-body--weight);
