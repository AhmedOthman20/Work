  .mazal-pdp__qty-input::-webkit-inner-spin-button,
  .mazal-pdp__qty-input::-webkit-outer-spin-button {
    margin: 0;
    -webkit-appearance: none;
  }

  .mazal-pdp__buy-now,
  .mazal-pdp__add {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 12px 16px;
    font-family: inherit;
    font-size: 14px;
    line-height: 1.45;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.2s, background-color 0.2s, color 0.2s;
