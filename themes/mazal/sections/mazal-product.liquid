{%- comment -%}
  Section contract.
  Mazal product page main section (Figma: Product Page desktop 1:1387, mobile 6:2739 + 6:2740).
  Gallery (main image + 2-column grid on desktop, main image + thumbnail strip on phones), title with
  wishlist toggle, Judge.me rating, price, size buttons, color swatches grouped into colors / stripes /
  checks, product details + care accordions, quantity + Buy now + Add to cart, related products, share.
  Reviews come from the standard reviews.rating / reviews.rating_count metafields that Judge.me syncs.
  Care instructions: product metafield custom.care_instructions, else the section setting.
  Related products: product metafield custom.related_products, else the section's product list.
  @example
  <!-- Used as the main section of templates/product.json -->
{%- endcomment -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign size_keyword = section.settings.size_option_name | downcase | strip
  assign color_keyword = section.settings.color_option_name | downcase | strip
  assign stripe_keyword = section.settings.stripe_keyword | downcase | strip
  assign check_keyword = section.settings.check_keyword | downcase | strip

  assign rating = product.metafields.reviews.rating.value.rating | default: 0
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0

  assign care_field = product.metafields.custom.care_instructions
  if care_field.type == 'rich_text_field'
    assign care = care_field | metafield_tag
  elsif care_field != blank
    assign care = care_field.value
  else
    assign care = section.settings.care_text
  endif

  assign sticky_save = 0
  if current_variant.compare_at_price > current_variant.price
    assign sticky_save = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round
  endif
  assign sticky_image = current_variant.featured_image | default: product.featured_image
  assign related = product.metafields.custom.related_products.value
  if related == blank
    assign related = section.settings.related_products
  endif

  assign title_font = settings.type_heading_font | font_modify: 'weight', '600'
  if title_font == blank
    assign title_font = settings.type_heading_font
  endif
  assign media_count = product.media.size
-%}

<style>
  {{ title_font | font_face: font_display: 'swap' }}
</style>

<div class="section-background"></div>
<mazal-product
  class="section mazal-pdp"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-product-url="{{ product.url }}"
  data-color-option="{{ section.settings.color_option_name | escape }}"
  style="
    --mazal-pdp-title-family: {{ title_font.family }}, {{ title_font.fallback_families }};
    --mazal-pdp-pt: {{ section.settings.padding_top }}px;
    --mazal-pdp-pb: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="mazal-pdp__grid">
    {%- comment -%} Gallery {%- endcomment -%}
    <div class="mazal-pdp__gallery">
      <div class="mazal-pdp__main-media">
        {%- assign main_media = current_variant.featured_media | default: product.featured_media -%}
        {%- if main_media -%}
          {{
            main_media.preview_image
            | image_url: width: 1600
            | image_tag:
              widths: '430, 600, 860, 1100, 1400, 1600',
              sizes: '(min-width: 750px) 50vw, 100vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: main_media.alt | default: product.title,
              class: 'mazal-pdp__main-image'
          }}
        {%- else -%}
          {{ 'product-apparel-1' | placeholder_svg_tag: 'mazal-pdp__main-image' }}
        {%- endif -%}
      </div>

      {%- if media_count > 1 -%}
        <ul class="mazal-pdp__thumbs" role="list">
          {%- for media in product.media -%}
            <li class="mazal-pdp__thumb-item{% if forloop.first %} mazal-pdp__thumb-item--first{% endif %}">
              <button
                type="button"
                class="mazal-pdp__thumb{% if media.id == main_media.id %} is-active{% endif %}"
                data-media-id="{{ media.id }}"
                data-src="{{ media.preview_image | image_url: width: 1600 }}"
                data-srcset="{{ media.preview_image | image_url: width: 430 }} 430w, {{ media.preview_image | image_url: width: 860 }} 860w, {{ media.preview_image | image_url: width: 1400 }} 1400w"
                aria-label="{{ media.alt | default: product.title | escape }} ({{ forloop.index }}/{{ media_count }})"
                aria-pressed="{% if media.id == main_media.id %}true{% else %}false{% endif %}"
              >
                {{
                  media.preview_image
                  | image_url: width: 800
                  | image_tag:
                    widths: '200, 400, 600, 800',
                    sizes: '(min-width: 750px) 25vw, 148px',
                    loading: 'lazy',
                    alt: '',
                    class: 'mazal-pdp__thumb-image'
                }}
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- comment -%} Details {%- endcomment -%}
    <div class="mazal-pdp__info">
      <div class="mazal-pdp__head">
        <div class="mazal-pdp__title-row">
          <h1 class="mazal-pdp__title">{{ product.title | escape }}</h1>
          {%- if section.settings.show_wishlist -%}
            <button
              type="button"
              class="mazal-pdp__wishlist"
              data-wishlist
              aria-pressed="false"
              aria-label="{{ section.settings.wishlist_label | escape }}"
            >
              {{- 'mazal-icon-heart.svg' | inline_asset_content -}}
            </button>
          {%- endif -%}
        </div>

        <div class="mazal-pdp__meta">
          {%- if rating_count > 0 -%}
            <a class="mazal-pdp__rating" href="#{{ section.settings.reviews_anchor | default: 'mazal-reviews' }}">
              {%- render 'mazal-stars', rating: rating, class: 'mazal-pdp__stars' -%}
              <span class="mazal-pdp__rating-value">{{ rating | times: 1.0 | round: 1 }}</span>
              <span class="mazal-pdp__rating-count">({{ rating_count }} {{ section.settings.reviews_label }})</span>
            </a>
          {%- endif -%}
          {%- if section.settings.shipping_text != blank -%}
            {%- if rating_count > 0 -%}<span class="mazal-pdp__meta-sep" aria-hidden="true">|</span>{%- endif -%}
            <span class="mazal-pdp__shipping">
              <span class="mazal-pdp__shipping-icon" aria-hidden="true">{{ 'mazal-icon-truck.svg' | inline_asset_content }}</span>
              {{- section.settings.shipping_text -}}
            </span>
          {%- endif -%}
        </div>

        <div class="mazal-pdp__price" data-price>
          <span class="mazal-pdp__price-current" data-price-current>{{ current_variant.price | money }}</span>
          <s class="mazal-pdp__price-compare" data-price-compare {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>
            {{- current_variant.compare_at_price | money -}}
          </s>
        </div>
      </div>

      <hr class="mazal-pdp__divider">

      {%- unless product.has_only_default_variant -%}
        <div class="mazal-pdp__options">
          {%- for option in product.options_with_values -%}
            {%- liquid
              assign option_key = option.name | downcase | strip
              assign is_color = false
              if option_key == color_keyword or option_key == 'color' or option_key == 'colour'
                assign is_color = true
              endif
            -%}
            {%- if is_color -%}
              {%- comment -%} Colors split into groups by name: plain colors, then stripes, then checks. {%- endcomment -%}
              {%- liquid
                assign has_plain = false
                assign has_stripes = false
                assign has_checks = false
                for value in option.values
                  assign value_key = value.name | downcase
                  if stripe_keyword != blank and value_key contains stripe_keyword
                    assign has_stripes = true
                  elsif check_keyword != blank and value_key contains check_keyword
                    assign has_checks = true
                  else
                    assign has_plain = true
                  endif
                endfor
              -%}
              {%- for group in (1..3) -%}
                {%- liquid
                  case group
                    when 1
                      assign show_group = has_plain
                      assign group_label = section.settings.color_label | default: option.name
                    when 2
                      assign show_group = has_stripes
                      assign group_label = section.settings.stripe_label
                    when 3
                      assign show_group = has_checks
                      assign group_label = section.settings.check_label
                  endcase
                -%}
                {%- if show_group -%}
                  <div class="mazal-pdp__option" role="group" aria-labelledby="MazalOption-{{ section.id }}-{{ option.position }}-{{ group }}" data-option-position="{{ option.position }}">
                    <span class="mazal-pdp__option-label" id="MazalOption-{{ section.id }}-{{ option.position }}-{{ group }}">{{ group_label | escape }}</span>
                    <div class="mazal-pdp__swatches">
                      {%- for value in option.values -%}
                        {%- liquid
                          assign value_key = value.name | downcase
                          assign value_group = 1
                          if stripe_keyword != blank and value_key contains stripe_keyword
                            assign value_group = 2
                          elsif check_keyword != blank and value_key contains check_keyword
                            assign value_group = 3
                          endif
                        -%}
                        {%- if value_group == group -%}
                          <button
                            type="button"
                            class="mazal-pdp__swatch{% if value.selected %} is-selected{% endif %}{% unless value.available %} is-unavailable{% endunless %}"
                            data-option-value="{{ value.name | escape }}"
                            aria-pressed="{{ value.selected }}"
                            aria-label="{{ value.name | escape }}"
                            title="{{ value.name | escape }}"
                          >
                            {%- render 'mazal-swatch', value: value, colors: section.settings.swatch_colors, class: 'mazal-pdp__swatch-fill' -%}
                          </button>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              <div class="mazal-pdp__option" role="group" aria-labelledby="MazalOption-{{ section.id }}-{{ option.position }}" data-option-position="{{ option.position }}">
                <div class="mazal-pdp__option-head">
                  <span class="mazal-pdp__option-label" id="MazalOption-{{ section.id }}-{{ option.position }}">{{ option.name | escape }}</span>
                  {%- if option_key contains size_keyword and section.settings.size_guide_url != blank -%}
                    <a class="mazal-pdp__size-guide" href="{{ section.settings.size_guide_url }}">{{ section.settings.size_guide_label | escape }}</a>
                  {%- endif -%}
                </div>
                <div class="mazal-pdp__pills">
                  {%- for value in option.values -%}
                    <button
                      type="button"
                      class="mazal-pdp__pill{% if value.selected %} is-selected{% endif %}{% unless value.available %} is-unavailable{% endunless %}"
                      data-option-value="{{ value.name | escape }}"
                      aria-pressed="{{ value.selected }}"
                    >
                      {{- value.name | escape -}}
                    </button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <hr class="mazal-pdp__divider">
      {%- endunless -%}

      {%- if product.description != blank or care != blank -%}
        <div class="mazal-pdp__accordions">
          {%- if product.description != blank -%}
            <details class="mazal-pdp__accordion">
              <summary class="mazal-pdp__accordion-title">
                {{- section.settings.details_label | escape -}}
                <span class="mazal-pdp__accordion-icon" aria-hidden="true">{{ 'mazal-icon-plus.svg' | inline_asset_content }}</span>
              </summary>
              <div class="mazal-pdp__accordion-body rte">{{ product.description }}</div>
            </details>
          {%- endif -%}
          {%- if care != blank -%}
            <details class="mazal-pdp__accordion">
              <summary class="mazal-pdp__accordion-title">
                {{- section.settings.care_label | escape -}}
                <span class="mazal-pdp__accordion-icon" aria-hidden="true">{{ 'mazal-icon-plus.svg' | inline_asset_content }}</span>
              </summary>
              <div class="mazal-pdp__accordion-body rte">
                {%- if care contains '<' -%}{{ care }}{%- else -%}{{ care | newline_to_br }}{%- endif -%}
              </div>
            </details>
          {%- endif -%}
        </div>

        <hr class="mazal-pdp__divider">
      {%- endif -%}

      {%- form 'product', product, class: 'mazal-pdp__form', data-product-form: '', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-input>
        <div class="mazal-pdp__ctas">
          <div class="mazal-pdp__buy-row">
            <div class="mazal-pdp__qty">
              <button type="button" class="mazal-pdp__qty-btn" data-qty-step="-1" aria-label="{{ 'accessibility.decrease_quantity' | t | default: 'Decrease quantity' }}">
                {{- 'mazal-icon-minus.svg' | inline_asset_content -}}
              </button>
              <input
                class="mazal-pdp__qty-input"
                type="number"
                name="quantity"
                value="1"
                min="1"
                inputmode="numeric"
                aria-label="{{ 'accessibility.quantity' | t | default: 'Quantity' }}"
                data-qty-input
              >
              <button type="button" class="mazal-pdp__qty-btn" data-qty-step="1" aria-label="{{ 'accessibility.increase_quantity' | t | default: 'Increase quantity' }}">
                {{- 'mazal-icon-plus-qty.svg' | inline_asset_content -}}
              </button>
            </div>
            <button
              type="submit"
              name="return_to"
              value="/checkout"
              class="mazal-pdp__buy-now"
              data-buy-now
              {% unless current_variant.available %}disabled{% endunless %}
            >
              {{- section.settings.buy_now_label | escape -}}
            </button>
          </div>
          <button
            type="button"
            class="mazal-pdp__add"
            data-add-to-cart
            data-label="{{ section.settings.add_to_cart_label | escape }}"
            data-sold-out-label="{{ section.settings.sold_out_label | escape }}"
            {% unless current_variant.available %}disabled{% endunless %}
          >
            <span class="mazal-pdp__add-icon" aria-hidden="true">{{ 'mazal-icon-bag.svg' | inline_asset_content }}</span>
            <span data-add-label>
              {%- if current_variant.available -%}
                {{- section.settings.add_to_cart_label | escape -}}
              {%- else -%}
                {{- section.settings.sold_out_label | escape -}}
              {%- endif -%}
            </span>
          </button>
        </div>
      {%- endform -%}

      {%- if related != blank -%}
        <div class="mazal-pdp__related">
          <h2 class="mazal-pdp__related-heading">{{ section.settings.related_heading | escape }}</h2>
          <ul class="mazal-pdp__related-list" role="list">
            {%- for item in related limit: section.settings.related_limit -%}
              {%- liquid
                assign item_variant = item.selected_or_first_available_variant
                assign save_percent = 0
                if item_variant.compare_at_price > item_variant.price
                  assign save_percent = item_variant.compare_at_price | minus: item_variant.price | times: 100.0 | divided_by: item_variant.compare_at_price | round
                endif
              -%}
              <li>
                <a class="mazal-pdp__related-card" href="{{ item.url }}">
                  <span class="mazal-pdp__related-media">
                    {%- if item.featured_image -%}
                      {{
                        item.featured_image
                        | image_url: width: 200
                        | image_tag: widths: '100, 200', sizes: '(min-width: 750px) 92px, 48px', loading: 'lazy', alt: item.title, class: 'mazal-pdp__related-image'
                      }}
                    {%- endif -%}
                  </span>
                  <span class="mazal-pdp__related-text">
                    <span class="mazal-pdp__related-name">
                      {{- item.title | escape -}}
                      {%- if save_percent > 0 and section.settings.save_label != blank -%}
                        <span class="mazal-pdp__related-save">{{ section.settings.save_label | replace: '[percent]', save_percent }}</span>
                      {%- endif -%}
                    </span>
                    {%- assign item_desc = item.metafields.custom.short_description.value | default: item.description | strip_html | truncatewords: 12 -%}
                    {%- if item_desc != blank -%}
                      <span class="mazal-pdp__related-desc">{{ item_desc }}</span>
                    {%- endif -%}
                    {%- if section.settings.related_cta != blank -%}
                      <span class="mazal-pdp__related-cta">{{ section.settings.related_cta | escape }}</span>
                    {%- endif -%}
                  </span>
                  <span class="mazal-pdp__related-price">
                    <span class="mazal-pdp__related-price-current">{{ item_variant.price | money }}</span>
                    {%- if item_variant.compare_at_price > item_variant.price -%}
                      <s class="mazal-pdp__related-price-compare">{{ item_variant.compare_at_price | money }}</s>
                    {%- endif -%}
                  </span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if section.settings.show_share -%}
        <div class="mazal-pdp__share">
          <span class="mazal-pdp__share-label">{{ section.settings.share_label | escape }}</span>
          <div class="mazal-pdp__share-icons">
            <button type="button" class="mazal-pdp__share-link" data-copy-link aria-label="{{ section.settings.copy_link_label | escape }}">
              {{- 'mazal-icon-link.svg' | inline_asset_content -}}
            </button>
            <a
              class="mazal-pdp__share-link"
              href="https://www.facebook.com/sharer/sharer.php?u={{ request.origin | append: product.url | url_encode }}"
              target="_blank"
              rel="noopener"
              aria-label="Facebook"
            >
              {{- 'mazal-icon-facebook.svg' | inline_asset_content -}}
            </a>
            {%- if section.settings.instagram_url != blank -%}
              <a class="mazal-pdp__share-link" href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
                {{- 'mazal-icon-instagram.svg' | inline_asset_content -}}
              </a>
            {%- endif -%}
            {%- if section.settings.tiktok_url != blank -%}
              <a class="mazal-pdp__share-link" href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener" aria-label="TikTok">
                {{- 'mazal-icon-tiktok.svg' | inline_asset_content -}}
              </a>
            {%- endif -%}
          </div>
          <span class="visually-hidden" role="status" data-copy-status></span>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_sticky -%}
    <div class="mazal-pdp__sticky" data-sticky aria-hidden="true" inert>
      <div class="mazal-pdp__sticky-left">
        <span class="mazal-pdp__sticky-media">
          {%- if sticky_image -%}
            {{
              sticky_image
              | image_url: width: 200
              | image_tag: widths: '100, 200', sizes: '(min-width: 750px) 92px, 56px', loading: 'lazy', alt: '', class: 'mazal-pdp__sticky-image', data-sticky-image: ''
            }}
          {%- endif -%}
        </span>
        <div class="mazal-pdp__sticky-text">
          <div class="mazal-pdp__sticky-name">
            <span class="mazal-pdp__sticky-title">{{ product.title | escape }}</span>
            {%- if section.settings.save_label != blank -%}
              <span class="mazal-pdp__sticky-save" data-sticky-save data-template="{{ section.settings.save_label | escape }}" {% if sticky_save == 0 %}hidden{% endif %}>
                {{- section.settings.save_label | replace: '[percent]', sticky_save -}}
              </span>
            {%- endif -%}
          </div>
          {%- unless product.has_only_default_variant -%}
            <div class="mazal-pdp__sticky-options" data-sticky-options></div>
          {%- endunless -%}
          <div class="mazal-pdp__sticky-price">
            <span class="mazal-pdp__sticky-price-current" data-sticky-price>{{ current_variant.price | money }}</span>
            <s class="mazal-pdp__sticky-price-compare" data-sticky-compare {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>
              {{- current_variant.compare_at_price | money -}}
            </s>
          </div>
        </div>
      </div>
      <button
        type="button"
        class="mazal-pdp__sticky-add"
        data-sticky-add
        {% unless current_variant.available %}disabled{% endunless %}
      >
        <span class="mazal-pdp__sticky-add-icon" aria-hidden="true">{{ 'mazal-icon-bag-white.svg' | inline_asset_content }}</span>
        <span data-sticky-add-label>
          {%- if current_variant.available -%}
            {{- section.settings.add_to_cart_label | escape -}}
          {%- else -%}
            {{- section.settings.sold_out_label | escape -}}
          {%- endif -%}
        </span>
      </button>
    </div>
  {%- endif -%}

  <script type="application/json" data-option-names>
    {{ product.options | json }}
  </script>
  <script type="application/json" data-variants>
    [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id }},
          "options": {{ variant.options | json }},
          "available": {{ variant.available | json }},
          "price": {{ variant.price | money | json }},
          "compare": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
          "media": {% if variant.featured_media %}{{ variant.featured_media.id }}{% else %}null{% endif %},
          "image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 200 | json }}{% else %}null{% endif %},
          "save": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round }}{% else %}0{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</mazal-product>

{%- render 'mazal-product-styles' -%}

<script src="{{ 'mazal-product.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "Mazal product",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    { "type": "header", "content": "Rating and shipping" },
    { "type": "text", "id": "reviews_label", "label": "Reviews count text", "default": "reviews" },
    { "type": "text", "id": "reviews_anchor", "label": "Rating links to element id", "default": "mazal-reviews", "info": "Clicking the stars scrolls to the reviews section." },
    { "type": "text", "id": "shipping_text", "label": "Shipping note", "default": "Fast Shipping", "info": "Leave empty to hide." },
    { "type": "header", "content": "Options" },
    { "type": "text", "id": "size_option_name", "label": "Size option name contains", "default": "size" },
    { "type": "url", "id": "size_guide_url", "label": "Size guide link", "info": "Shows \"Size Guide\" next to the size option." },
    { "type": "text", "id": "size_guide_label", "label": "Size guide text", "default": "Size Guide" },
    { "type": "text", "id": "color_option_name", "label": "Color option name", "default": "Color" },
    { "type": "text", "id": "color_label", "label": "Plain colors heading", "default": "COLOR" },
    { "type": "text", "id": "stripe_keyword", "label": "Stripe values contain", "default": "stripe" },
    { "type": "text", "id": "stripe_label", "label": "Stripes heading", "default": "STRIPES" },
    { "type": "text", "id": "check_keyword", "label": "Check values contain", "default": "check" },
    { "type": "text", "id": "check_label", "label": "Checks heading", "default": "CHECKS" },
    {
      "type": "textarea",
      "id": "swatch_colors",
      "label": "Swatch colors",
      "default": "Pink: #f6c9d1\nGrey: #dbdada\nPeach: #f6ddc9\nMint: #c9f6e0",
